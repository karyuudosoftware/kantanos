[Unit]
Description=KantanOS local AI (Ollama, for the KantanOS Helper)
Documentation=file:///usr/libexec/kantanos/helper

[Service]
# Started by the Helper's "Set up" (and by apps that use it); runs as the user, models in
# the home folder, reachable only from this PC.
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/ollama/models
# Use the graphics card through Vulkan (NVIDIA, AMD and Intel)
Environment=OLLAMA_VULKAN=1
# Unload the model after 10 idle minutes so games get the video memory back
Environment=OLLAMA_KEEP_ALIVE=10m
ExecStart=/usr/bin/ollama serve
Restart=on-failure

[Install]
WantedBy=default.target
