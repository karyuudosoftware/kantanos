# KantanOS safe picture: look at the screens again when one is plugged in or switched on, and
# when a graphics driver starts (see /usr/libexec/kantanos/safe-picture).
ACTION=="change", SUBSYSTEM=="drm", ENV{HOTPLUG}=="1", RUN+="/usr/bin/systemctl --no-block start kantanos-safe-picture.service"
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]", RUN+="/usr/bin/systemctl --no-block start kantanos-safe-picture.service"
