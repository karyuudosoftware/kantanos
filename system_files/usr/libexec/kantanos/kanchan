def main():
    if "--self-test" in sys.argv:
        return self_test()
    if "--check-in" in sys.argv:
        return check_in()
    if "--disable" in sys.argv:
        set_in_menu(False)
        set_check_in(False)
        set_buddy(False)
        return
    if "--enable" in sys.argv:
        set_in_menu(True)
    # The desktop gives a program it starts (e.g. from Meta+K) a token that lets it bring a window
    # to the front. Read it before Qt does, so it can be handed to the window that's already open.
    token = os.environ.get("XDG_ACTIVATION_TOKEN", "")
    app = QApplication(sys.argv)
    app.setApplicationName("kantanos-kanchan")
    app.setDesktopFileName("kantanos-kanchan")
    word = b"listen" if "--listen" in sys.argv else b"show"
    sock_name = f"kantanos-kanchan-{os.getuid()}"
    other = QLocalSocket()
    other.connectToServer(sock_name)
    if other.waitForConnected(500):               # her window is already open: pass it on
        other.write(word + b" " + token.encode())
        other.flush()
        other.waitForBytesWritten(1000)
        return
    QLocalServer.removeServer(sock_name)
    server = QLocalServer()
    server.listen(sock_name)
    if word == b"listen":
        Companion.hello = lambda self: setattr(self, "said_hello", True)      # straight to listening
    w = Companion()

    def knock():
        c = server.nextPendingConnection()
        if c and c.waitForReadyRead(1000):
            what, _, tok = bytes(c.readAll()).decode(errors="replace").strip().partition(" ")
            if tok:
                os.environ["XDG_ACTIVATION_TOKEN"] = tok.strip()   # Qt uses it on the next activate
            if what == "listen":
                w.listen_key()
            else:
                w.come_forward()
    server.newConnection.connect(knock)
    w.show()
    if word == b"listen":
        QTimer.singleShot(600, w.listen_key)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
