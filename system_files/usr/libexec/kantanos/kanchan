    # ---- email and calendar -------------------------------------------------------------------
    def start_mail(self):
        """The local server Thunderbird's helper add-on talks to (only while this window is open)."""
        if self.mailbox:
            return
        b = mail.Bridge(on_event=lambda ev: self.bridge.done.emit("mail-event", ("ok", ev)))
        if b.start():
            self.mailbox = b
            self.in_thread("mail-status", self.mail_status)

    def mail_status(self):
        for _ in range(20):                       # wait for Thunderbird to check in
            if self.mailbox.connected():
                return self.mailbox.ask("status", timeout=15)
            time.sleep(1)
        return None

    def open_mail(self):
        MailSetup(self).exec()

    def mail_said(self, text):
        """An email request (or a yes/no to one). True when it was about email."""
        if not self.cfg.get("kanchan_mail") or not self.mailbox:
            it = mail.intent(text)
            if it and it[0] in ("check", "write"):
                self.answer({"reply": "I can't see your email yet. Someone can set it up in “Email and calendar…” "
                                      "next to me (it uses Thunderbird)."}, keep=False)
                return True
            return False
        step = self.mail_talk.hear(text)
        if step is None:
            return False
        self.mail_step(step)
        return True

    def mail_step(self, step):
        self.retire_card()
        if step.get("stop"):
            self.voice.stop()
            return
        if step.get("say"):
            self.answer({"reply": step["say"]}, keep=False)
        if step.get("confirm"):
            self.confirm_card(step["confirm"])
        if step.get("run"):
            op, args = step["run"]
            if not self.mailbox.connected() and not mail.thunderbird_running():
                mail.open_thunderbird()
                self.small("Opening Thunderbird…")
            self.mood("think")
            self.thinking = True

            def work():
                for _ in range(60):
                    if self.mailbox.connected():
                        break
                    time.sleep(1)
                else:
                    raise mail.MailError("Thunderbird isn't answering. Is it open?")
                return step, self.mailbox.ask(op, timeout=90 if op in ("reply", "write") else 40, **args)
            self.in_thread("mail", work)

    def confirm_card(self, c):
        """Big Yes/No buttons; saying yes or no works too. Nothing is sent or binned without it."""
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(8, 4, 0, 4)
        big = QFont(); big.setPointSizeF(big.pointSizeF() * 1.3); big.setBold(True)
        yes = QPushButton(QIcon.fromTheme("mail-send" if c["kind"] != "bin" else "user-trash"), c["yes"])
        no = QPushButton(QIcon.fromTheme("dialog-cancel"), c["no"])
        for b in (yes, no):
            b.setFont(big)
            b.setMinimumHeight(56)
            h.addWidget(b)
        h.addStretch()

        mine = self.mail_talk.pending   # this card answers this one email only, never a later one

        def pick(word):
            yes.setEnabled(False)
            no.setEnabled(False)
            if mine is not None and self.mail_talk.pending is mine:
                self.bubble(word.capitalize(), True)
                self.mail_step(self.mail_talk.hear(word) or {"say": ""})
        yes.clicked.connect(lambda: pick("yes"))
        no.clicked.connect(lambda: pick("no"))
        yes.setAccessibleName(c["yes"])
        no.setAccessibleName(c["no"])
        self.results_lay.addWidget(row)
        self.live_card = (yes, no, mine)
        self.scroll_down()

    def retire_card(self):
        """Greys out the Yes/No buttons once their question has been answered some other way."""
        card = getattr(self, "live_card", None)
        if card and self.mail_talk.pending is not card[2]:
            card[0].setEnabled(False)
            card[1].setEnabled(False)
            self.live_card = None

    def agenda_said(self, text):
        links = self.cfg.get("calendar_links") or []
        asked = agenda.ask_day(text)
        if not asked or not links:
            return False
        day, word = asked
        self.mood("think")
        self.thinking = True

        def work():
            s, e = agenda.day_range(day)
            evs, errors = agenda.all_events(links, s, e)
            if errors and not evs:
                return "I couldn't read your calendar just now. Is the internet working?"
            return agenda.day_text(evs, word)
        self.in_thread("agenda", work)
        return True

    # ---- the AI --------------------------------------------------------------------------
    def ai(self):
        """(endpoint, private) or (None, why): private means the AI runs on this PC."""
        ep = brain.endpoint(self.cfg, H.local_model()[0])
        if ep["kind"] == "openai":
            return ep, TEST_PRIVATE
        if not H.ollama_up() or not H.local_ready(ep["model"]):
            return None, "local-missing"
        return ep, True

    def show_ai(self):
        if self.cfg.get("provider") == "online" and self.cfg.get("online_url"):
            host = urllib.parse.urlparse(self.cfg["online_url"]).hostname or "online"
            self.ai_label.setText(f"AI: {host} (online). Your notes stay on this PC."
                                  + (" Test mode: treated as private." if TEST_PRIVATE else ""))
        else:
            self.ai_label.setText("AI: on this PC (private)")
        why = self.eyes_blocked()
        self.see.setEnabled(why != "engine")
        if why == "online":
            if self.see.isChecked():
                self.see.setChecked(False)
            self.see.setToolTip("Seeing works only with the AI on this PC, so nothing I see ever goes online.")

    def ask_online(self):
        if self.online_ok:
            return True
        host = urllib.parse.urlparse(self.cfg["online_url"]).hostname
        box = QMessageBox(self)
        box.setWindowTitle(TITLE)
        box.setIcon(QMessageBox.Question)
        box.setText(f"Send our conversation to {host}?")
        box.setInformativeText("Your AI settings use an online service. What you say in this window goes "
                               "there, with personal details removed. Your name and my notes about you "
                               "stay on this PC. I'll ask again next time.")
        box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
        box.button(QMessageBox.Yes).setText("Send")
        box.button(QMessageBox.No).setText("Don't send")
        self.online_ok = box.exec() == QMessageBox.Yes
        return self.online_ok

    def messages(self, private, extra=None):
        notes = self.mem.all() if private else []
        person = self.me.get("name", "") if private else ""
        history = self.chat if private else [{"role": m["role"], "content": H.redact(m["content"])}
                                             for m in self.chat]
        msgs = brain.build_messages(self.char_name, person, notes, history + ([extra] if extra else []),
                                    style=self.style)
        if private and (self.cfg.get("kanchan_notice_games") or self.cfg.get("kanchan_notice_shows")):
            seen = brain.activity_text(self.acts.recent(), person)
            if seen:
                msgs[0]["content"] += "\n\n" + seen
        if private and self.see.isChecked() and self.in_view:     # names and sights never go online
            view = [{"name": p["name"], "change": self.changes.get(p["pid"])} for p in self.in_view]
            self.told = {p["pid"] for p in self.in_view if p["pid"] in self.changes}
            msgs[0]["content"] += "\n\n" + vision.scene(view)
        return msgs

    def hello(self):
        if self.see.isChecked() and not self.first_look and self.hello_wait < 10:
            self.hello_wait += 1               # say hello once I've had a first look
            QTimer.singleShot(400, self.hello)
            return
        self.said_hello = True
        said = os.environ.pop("KANTAN_KANCHAN_HELLO", "")
        if said:                                   # opened from her daily hello
            self.answer({"reply": said}, keep=True)
            return
        name = self.me.get("name")
        greet = {"morning": "Good morning", "afternoon": "Hi", "evening": "Good evening",
                 "night": "Hi"}[brain.part_of_day()]
        ep, private = self.ai()
        noticed = (self.cfg.get("kanchan_notice_games") or self.cfg.get("kanchan_notice_shows")) and self.acts.recent()
        if ep and private is True and (self.mem.all() or noticed or any(p["pid"] for p in self.in_view)):
            self.mood("think")
            self.in_thread("opener", self.run_ai, ep, self.messages(True, brain.opener_turn(name)))
            return
        if not name:
            text = (f"{greet}! I'm {self.char_name}. I live on this PC and I'd love to get to know you. "
                    "What should I call you?")
        else:
            text = f"{greet}, {name}! What's on your mind?"
        self.answer({"reply": text}, keep=True)
        QTimer.singleShot(900, self.first_steps)
        if not ep and not self.cfg.get("provider") == "online":
            self.status.setText("Tip: set up the AI in AI settings so we can really chat. Until then I can "
                                "still remember things you tell me (“remember …”).")

    def first_steps(self):
        """First visit: introductions, then her voice (one question at a time)."""
        if not self.me.get("name") and not self.cfg.get("kanchan_name_asked"):
            self.cfg["kanchan_name_asked"] = True
            H.save(self.cfg)
            self.ask_name()
        if self.talk.isChecked() and not self.voice.ready() and not self.cfg.get("kanchan_voice_asked"):
            self.cfg["kanchan_voice_asked"] = True
            H.save(self.cfg)
            self.offer_voice()

    def last_said(self):
        return next((m["content"] for m in reversed(self.chat) if m["role"] == "user"), "")

    def quiet(self):
        """Nobody's talking: fine for her to bring something up herself."""
        return (self.said_hello and not self.thinking and not self.ears.recording()
                and time.monotonic() - self.last_talk > 20)

    def speak_up(self, why):
        """Say something on her own (someone came in, she noticed something)."""
        ep, private = self.ai()
        if not ep or private is not True:
            return False
        self.thinking = True
        self.last_talk = time.monotonic()
        self.in_thread("aside", self.run_ai, ep, self.messages(True, {"role": "user", "content":
                       f"(Not said aloud: {why} Say it in one short, friendly sentence. "
                       + ("Don't greet the person you're already talking with again. " if self.chat else "")
                       + "Leave remember and forget empty.)"}))
        return True

    @staticmethod
    def run_ai(ep, msgs):
        return brain.parse(brain.complete(ep, msgs))

    # ---- what you say ----------------------------------------------------------------------
    def typed(self):
        text = self.entry.text().strip()
        if text:
            self.entry.clear()
            self.said(text)

    def said(self, text):
        self.bubble(text, True)
        if self.mail_said(text) or self.agenda_said(text):   # handled here, never by the AI
            return
        self.chat.append({"role": "user", "content": text})
        intent = brain.quick_intent(text)
        if intent and intent[0] == "list":
            self.open_memory()
        ep, private = self.ai()
        if ep and not private and intent and intent[0] == "forget":
            ep = None              # an online AI never sees the notes, so forgetting is done here
        if ep and not private and not self.ask_online():
            ep = None
        if not ep:
            return self.without_ai(text, intent)
        self.mood("think")
        self.thinking = True
        self.status.setText(f"{self.char_name} is thinking…")
        self.in_thread("chat", self.run_ai, ep, self.messages(private))

    def without_ai(self, text, intent):
        if intent and intent[0] == "remember" and brain.SECRET.search(intent[1]):
            return self.answer({"reply": "I'd rather not keep passwords or numbers like that. "
                                         "A password manager is the safe place for them."}, keep=False)
        if intent and intent[0] == "remember":
            self.note(self.mem.add(intent[1]))
            return self.answer({"reply": "Got it, I'll remember that."}, keep=False)
        if intent and intent[0] == "forget":
            hits = self.mem.find(intent[1])
            for nid in hits:
                note = self.mem.get(nid)
                self.mem.delete(nid)
                self.small(f"Forgot: {note['text']}")
            return self.answer({"reply": "Done, I've forgotten that." if hits else
                                "I couldn't find that in my notes. Have a look in “What I remember”."}, keep=False)
        if intent and intent[0] == "list":
            return self.answer({"reply": "Here's everything I remember."}, keep=False)
        reply = ("I can't chat properly yet: the AI on this PC isn't set up. Open AI settings and press "
                 "“Set up”, and then we can talk about anything.")
        self.answer({"reply": reply}, keep=False)

    def answer(self, ans, keep=True, said=""):
        self.status.setText("")
        self.thinking = False
        self.last_talk = time.monotonic()
        for pid in self.told:                 # she's had the chance to mention it now
            self.changes.pop(pid, None)
        self.told = set()
        reply = ans.get("reply") or "Hmm, I'm not sure what to say. Could you put it another way?"
        self.bubble(reply, False)
        if keep:
            self.chat.append({"role": "assistant", "content": reply})
        notes = list(ans.get("remember", []))
        intent = brain.quick_intent(said) if said else None
        if intent and intent[0] == "remember" and not notes:
            notes = [intent[1]]                      # asked outright: kept even if the AI forgot to
        for note in notes:
            if brain.keep_note(note, said) and not self.mem.exists(note):
                self.note(self.mem.add(note))
        forget = list(ans.get("forget", []))
        if intent and intent[0] == "forget" and not forget:
            forget = self.mem.find(intent[1])        # e.g. an online AI, which never sees the notes
        for nid in forget:
            note = self.mem.get(nid)
            if note:
                self.mem.delete(nid)
                self.small(f"Forgot: {note['text']}")
        if ans.get("helper"):
            self.helper_card(said)
        if ans.get("lookup"):
            self.lookup_card(ans["lookup"], said)
        if ans.get("recipe"):          # they said yes: the Recipe book writes it out, shown for checking
            self.small(f"Opening the Recipe book for: {ans['recipe']}")
            subprocess.Popen(["kantan-recipes", "--write", ans["recipe"]], start_new_session=True)
        self.mood("happy")
        QTimer.singleShot(2500, lambda: self.mood("idle"))
        self.say(reply)

    def note(self, nid):
        note = self.mem.get(nid) if nid else None
        if not note:
            return
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(8, 0, 0, 0)
        label = QLabel(f"📝 Noted: {note['text']}")
        label.setStyleSheet("color: palette(placeholder-text);")
        h.addWidget(label)
        undo = QPushButton("Undo")
        undo.setFlat(True)
        undo.setStyleSheet("color: palette(link);")

        def forget():
            self.mem.delete(nid)
            label.setText(f"Not noted: {note['text']}")
            undo.hide()
        undo.clicked.connect(forget)
        h.addWidget(undo)
        h.addStretch()
        self.results_lay.addWidget(row)
        self.scroll_down()

    def small(self, text):
        label = QLabel(text)
        label.setStyleSheet("color: palette(placeholder-text); margin-left: 8px;")
        self.results_lay.addWidget(label)

    def helper_card(self, said):
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(8, 0, 0, 0)
        b = QPushButton(QIcon.fromTheme("help-browser"), "Open the KantanOS Helper")
        b.clicked.connect(lambda: subprocess.Popen([HELPER] + ([said] if said else []), start_new_session=True))
        h.addWidget(b)
        h.addStretch()
        self.results_lay.addWidget(row)

    def lookup_card(self, look, said):
        """She'd like to look something up: show exactly what would go online, and ask."""
        query = H.redact(look["query"])
        where = {"weather": "the Open-Meteo weather service", "facts": "Wikipedia",
                 "web": "DuckDuckGo"}[look["kind"]]
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(8, 0, 0, 0)
        label = QLabel(f"🔎 Look this up online? I'd ask {where} for “{query}”. Nothing else is sent.")
        label.setWordWrap(True)
        label.setStyleSheet("color: palette(placeholder-text);")
        h.addWidget(label, 1)
        yes = QPushButton(QIcon.fromTheme("edit-find"), "Look it up")
        no = QPushButton("No thanks")
        h.addWidget(yes)
        h.addWidget(no)

        def go():
            yes.hide()
            no.hide()
            label.setText(f"🔎 Looking up “{query}” on {where}…")
            self.mood("think")
            self.thinking = True
            lang = "ja" if H.has_japanese(said) else "en"
            self.in_thread("lookup", lambda: (query, brain.lookup(look["kind"], query, lang)))

        def skip():
            yes.hide()
            no.hide()
            label.setText(f"Not looked up: “{query}”")
            self.answer({"reply": "Okay, no problem!"}, keep=True)
        yes.clicked.connect(go)
        no.clicked.connect(skip)
        self.results_lay.addWidget(row)
        self.scroll_down()

    def bubble(self, text, mine):
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 2, 0, 2)
        label = QLabel(text)
        label.setTextFormat(Qt.PlainText)          # keeps a recipe's lines as they are
        label.setWordWrap(True)
        label.setTextInteractionFlags(Qt.TextSelectableByMouse)
        label.setMaximumWidth(520)
        label.setStyleSheet("QLabel { border-radius: 12px; padding: 8px 12px; background: "
                            + ("palette(highlight); color: palette(highlighted-text);" if mine
                               else "palette(alternate-base);") + " }")
        if mine:
            h.addStretch()
        h.addWidget(label)
        if not mine:
            h.addStretch()
        self.results_lay.addWidget(row)
        self.scroll_down()

    def scroll_down(self):
        bar = self.scroll.verticalScrollBar()
        QTimer.singleShot(60, lambda: bar.setValue(bar.maximum()))

    # ---- talking out loud ------------------------------------------------------------------
    def talk_pressed(self):
        if self.ears.recording():
            return
        self.voice.stop()
        self.speech.stop()
        self.avatar_mouth(None)
        if not self.ears.ready():
            ok = QMessageBox.question(
                self, TITLE, f"To understand what you say, I need a speech model: a one-time download of "
                f"{H.STT_SIZE}. It runs on this PC: your voice is never sent anywhere and recordings aren't "
                "kept. Download it now?", QMessageBox.Yes | QMessageBox.No)
            if ok == QMessageBox.Yes:
                self.talk_btn.setEnabled(False)
                self.status.setText(f"Downloading the speech model ({H.STT_SIZE})…")
                self.in_thread("stt-dl", self.ears.download)
            return
        try:
            self.ears.start()
        except OSError as e:
            self.status.setText(f"The microphone couldn't be opened ({e}).")
            return
        self.listen_started, self.listen_toggle = time.monotonic(), False
        self.listen_limit.start()
        self.mood("listen")
        self.talk_btn.setText("Listening… let go when done")

    def talk_released(self):
        if not self.ears.recording():
            return
        if not self.listen_toggle and time.monotonic() - self.listen_started < 0.45:
            self.listen_toggle = True
            self.talk_btn.setText("Listening… click to stop")
            return
        self.stop_listening()

    def stop_listening(self):
        self.listen_limit.stop()
        if not self.ears.recording():
            return
        path = self.ears.stop()
        self.talk_btn.setText("Hold to talk")
        if not path:
            self.mood("worried")
            self.status.setText("I couldn't hear anything. Is a microphone connected and switched on?")
            return
        self.mood("think")
        self.talk_btn.setEnabled(False)
        self.status.setText("Listening back…")
        self.in_thread("stt", self.ears.transcribe, path, self.me)

    def check_in_toggled(self, on):
        self.cfg["kanchan_checkin"] = on
        H.save(self.cfg)
        set_check_in(on)

    def voice_toggled(self, on):
        self.cfg["kanchan_voice"] = on
        H.save(self.cfg)
        if not on:
            self.voice.stop()
        elif not self.voice.ready():
            self.offer_voice()

    def offer_voice(self):
        ok = QMessageBox.question(self, TITLE, "My voice runs on this PC and needs a one-time download of "
                                  f"{self.voice.download_note}. Download it now?",
                                  QMessageBox.Yes | QMessageBox.No)
        if ok != QMessageBox.Yes:
            self.talk.setChecked(False)
            return
        self.status.setText("Downloading my voice…")
        self.in_thread("voice-dl", self.voice.download)

    def say(self, text, force=False):
        text = H.spoken(H.speakable(text or ""), self.me)
        if not text or not (self.talk.isChecked() or force) or not self.voice.ready():
            return
        if H.has_japanese(text) and not self.voice.japanese:
            return
        self.in_thread("voice-synth", self.voice.synthesize, text[:900])

    def avatar_mouth(self, m):
        if isinstance(self.avatar, H.Avatar):
            self.avatar.mouth = m

    def mouth_step(self):
        if self.level_i >= len(self.levels) or (self.voice.player and self.voice.player.poll() is not None):
            self.speech.stop()
            self.avatar_mouth(None)
            return
        level = self.levels[self.level_i]
        self.level_i += 1
        self.avatar_mouth("talk2" if level > 0.45 else "talk1" if level > 0.12 else None)

    def mood(self, name):
        if isinstance(self.avatar, H.Avatar):
            self.avatar.set_mood(name)

    # ---- your name, notes, settings ------------------------------------------------------
    def show_name(self):
        name = self.me.get("name")
        self.name_btn.setText(f"I call you {name} (change)" if name else "Tell me your name")

    def ask_name(self):
        d = self.name_dialog = H.NameDialog(self, self.me)
        ok = d.exec() == QDialog.Accepted
        self.name_dialog = None
        if not ok:
            return
        self.me = d.result_me()
        H.save_me(self.me)
        self.cfg["name_asked"] = True
        H.save(self.cfg)
        self.show_name()
        if self.me.get("name"):
            self.answer({"reply": f"Nice to meet you, {self.me['name']}!"}, keep=True)

    def open_memory(self):
        Remembered(self, self.mem, self.me.get("name"), self.people, self.acts, self.cfg).exec()

    # ---- seeing ----------------------------------------------------------------------------
    def eyes_blocked(self):
        """Why she can't see right now ("" if she can)."""
        if not vision.available():
            return "engine"
        if self.cfg.get("provider") == "online" and self.cfg.get("online_url") and not TEST_PRIVATE:
            return "online"
        if not vision.has_camera():
            return "camera"
        return ""

    def see_toggled(self, on):
        if not on:
            self.cfg["kanchan_see"] = False
            H.save(self.cfg)
            return self.stop_eyes()
        why = self.eyes_blocked()
        if why:
            self.see.setChecked(False)
            self.status.setText({"camera": "I can't find a webcam. Plug one in and try again.",
                                 "online": "Seeing works only with the AI on this PC (AI settings), so nothing "
                                           "I see ever goes online.",
                                 "engine": "Seeing isn't installed on this PC."}[why])
            return
        if not self.cfg.get("kanchan_see_ok"):
            box = QMessageBox(self)
            box.setWindowTitle(TITLE)
            box.setIcon(QMessageBox.Question)
            box.setText("Let me see through the webcam?")
            box.setInformativeText(
                "While my window is open I'll look every couple of seconds. I recognise only people you "
                "introduce to me (press “Introduce someone”); anyone else is ignored and nothing about them "
                "is kept. For people I know, I keep a face fingerprint and a short note of how they looked "
                "(hair, glasses), so I can say things like “you changed your hair!”. No photos are saved, "
                "and nothing I see goes online. You can switch this off any time.")
            box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
            box.button(QMessageBox.Yes).setText("Let her see")
            box.button(QMessageBox.No).setText("Not now")
            if box.exec() != QMessageBox.Yes:
                self.see.setChecked(False)
                return
            self.cfg["kanchan_see_ok"] = True
        self.cfg["kanchan_see"] = True
        H.save(self.cfg)
        self.cam = vision.Camera()
        self.eye_close = False
        self.in_thread("eye-open", self.open_eyes)

    def open_eyes(self):
        if not self.cam.open():
            return False
        if not self.faces:
            self.faces = vision.Faces()
        return True

    def avatar_size(self, small):
        """A smaller Kan-chan while the camera preview shows, so the window fits small screens."""
        if not isinstance(self.avatar, H.Avatar):
            return
        if self.avatar.full:                # head to shoes
            self.avatar.setFixedSize(*((130, 300) if small else (190, 440)))
        else:                               # a pack without full-length pictures: head to hips
            self.avatar.setFixedSize(*((168, 210) if small else (240, 300)))

    def stop_eyes(self):
        self.eye_timer.stop()
        self.eye_box.hide()
        self.avatar_size(False)
        self.in_view, self.enrol = [], None
        if self.cam:
            if self.eye_busy:
                self.eye_close = True          # closed when the current look is done
            else:
                self.cam.close()
                self.cam = None

    def eye_tick(self):
        if self.eye_busy or not self.cam:
            return
        self.eye_busy = True
        self.in_thread("look", self.look_once)

    def look_once(self):
        frame = self.cam.grab()
        if frame is None:
            return None
        found = self.faces.find(frame)
        self.last_frame = frame
        cv2 = vision.cv2
        h, w = frame.shape[:2]
        scale = 224 / w
        small = cv2.cvtColor(cv2.resize(frame, (224, max(1, int(h * scale)))), cv2.COLOR_BGR2RGB)
        return {"rgb": small.copy(), "scale": scale, "faces": found}

    def saw(self, value):
        self.first_look = True
        view = []
        for f in value["faces"]:
            pid, _ = self.people.match(f["feature"])
            person = self.people.get(pid) if pid else None
            view.append({"pid": pid, "name": person["name"] if person else None, "box": f["box"],
                         "feature": f["feature"]})
        self.in_view = view
        self.draw_preview(value["rgb"], value["scale"], view)
        if self.enrol:
            return self.enrol_step(view)
        owner = (self.me.get("name") or "").lower()
        for p in view:
            if p["pid"] and p["pid"] not in self.seen_now:
                self.seen_now.add(p["pid"])
                self.people.saw(p["pid"])
                if p["name"].lower() != owner and self.quiet():
                    if not self.speak_up(f"{p['name']} has just come into view of your webcam: say hello to "
                                         f"{p['name']}."):
                        self.answer({"reply": f"Hi, {p['name']}!"}, keep=True)
        for p in view:
            if p["pid"]:
                self.look_check(p)
        if self.changes and self.quiet() and not self.told:
            pid, what = next(iter(self.changes.items()))
            person = self.people.get(pid)
            if person and any(p["pid"] == pid for p in view):
                self.speak_up(f"you've just noticed something new about {person['name']}: {what}. Mention it "
                              "kindly.")

    def draw_preview(self, rgb, scale, view):
        h, w = rgb.shape[:2]
        img = QImage(rgb.data, w, h, 3 * w, QImage.Format_RGB888).copy()
        paint = QPainter(img)
        for p in view:
            x, y, bw, bh = (int(v * scale) for v in p["box"])
            paint.setPen(QPen(QColor("#3cc864") if p["pid"] else QColor("#b0b0b0"), 2))
            paint.drawRect(x, y, bw, bh)
            paint.drawText(x, max(10, y - 3), p["name"] or "?")
        paint.end()
        self.preview.setPixmap(QPixmap.fromImage(img).scaled(self.preview.size(), Qt.KeepAspectRatio,
                                                             Qt.SmoothTransformation))

    def look_check(self, p):
        """Once per visit: how do they look today, and has something clearly changed?"""
        ep, private = self.ai()
        st = self.looks.setdefault(p["pid"], {"stage": 0, "t": 0.0, "a": None})
        if not ep or private is not True or self.describing or st["stage"] >= 2 or self.last_frame is None:
            return
        if st["stage"] == 1 and time.monotonic() - st["t"] < 20:
            return                              # a second look a little later, to be sure
        jpg = vision.head_and_shoulders(self.last_frame, p["box"])
        if not jpg:
            return
        self.describing = True
        pid, stage = p["pid"], st["stage"]
        self.in_thread("describe", lambda: (pid, stage, vision.describe(ep, jpg)))

    def described(self, value):
        pid, stage, look = value
        st = self.looks.get(pid)
        person = self.people.get(pid)
        if not st or not person:
            return
        if not look:
            st["stage"] = 2                     # this AI can't see pictures: just recognise people
            return
        before = person.get("look")
        if stage == 0:
            st.update(stage=1, t=time.monotonic(), a=look)
            if not before:
                self.people.set_look(pid, look)
                st["stage"] = 2
            return
        st["stage"] = 2
        ep, _ = self.ai()
        first = st["a"]

        def compare():
            what = vision.changed(ep, before, first)
            return pid, (what if what and vision.changed(ep, before, look) else ""), look
        self.describing = True
        self.in_thread("changed", compare)

    def introduce(self):
        if not self.in_view:
            self.status.setText("I can't see anyone right now. Sit in front of the webcam, then try again.")
            return
        near = self.in_view[0]
        owner = self.me.get("name") or ""
        default = near["name"] or ("" if not owner or self.people.by_name(owner) else owner)
        name, ok = QInputDialog.getText(
            self, "Introduce someone", "Who's nearest the webcam right now?\n\nI'll only recognise people "
            "introduced here. Anyone else is ignored and nothing about them is kept.", text=default)
        name = name.strip()
        if not ok or not name:
            return
        if near["name"] and near["name"].lower() != name.lower():
            if QMessageBox.question(self, TITLE, f"That looks like {near['name']} to me. Is it really {name}?",
                                    QMessageBox.Yes | QMessageBox.No) != QMessageBox.Yes:
                return
        pid = self.people.add(name)
        self.enrol = {"pid": pid, "name": name, "left": 6, "first": None}
        self.status.setText(f"Hold still for a moment, {name}: I'm learning your face…")

    def enrol_step(self, view):
        e = self.enrol
        if not view:
            return
        f = view[0]["feature"]
        if e["first"] is None:
            e["first"] = f
        elif float(vision.np.dot(e["first"], f)) < vision.SAME:
            return                              # someone else moved in front: skip this look
        self.people.add_face(e["pid"], f)
        e["left"] -= 1
        if e["left"] > 0:
            return
        self.enrol = None
        self.seen_now.add(e["pid"])
        self.people.saw(e["pid"])
        self.status.setText("")
        self.answer({"reply": f"Nice to meet you, {e['name']}! I'll know you next time."}, keep=True)

    def make_character(self):
        if CharacterMaker(self, self.cfg).exec() != QDialog.Accepted:
            return
        pack = H.character_dir(self.cfg.get("character", "kan-chan"))
        info = maker.load(pack) if pack else {}
        self.char_name = info.get("name", TITLE)
        self.style = maker.style_text(info.get("style"))
        self.name_label.setText(self.char_name)
        self.setWindowTitle(self.char_name)
        self.entry.setPlaceholderText(f"Type to {self.char_name}…")
        self.voice.stop()
        self.voice = H.Voice(self.cfg.get("voice") or info.get("voice", H.DEFAULT_VOICE))
        if pack and isinstance(self.avatar, H.Avatar):
            new = H.Avatar(pack, full=True)
            self.side.replaceWidget(self.avatar, new)
            self.avatar.deleteLater()
            self.avatar = new
            self.avatar_size(self.eye_box.isVisible())
        self.chat = []
        self.answer({"reply": f"Hi! I'm {self.char_name}. Nice to meet you!"}, keep=True)

    def open_settings(self):
        d = H.Settings(self, self.cfg)
        if d.exec() != QDialog.Accepted:
            return
        self.cfg = d.result_cfg()
        H.save(self.cfg)
        self.show_ai()
        if d.wants_setup:
            self.setup_local()

    def setup_local(self):
        model, size = H.local_model()
        self.cfg["local_model"] = model
        H.save(self.cfg)
        self.bar.show()
        self.bar.setRange(0, 0)
        self.status.setText(f"Setting up the AI on this PC: downloading {model} ({size}). This happens once.")

        def work():
            subprocess.run(["systemctl", "--user", "start", H.OLLAMA_UNIT])
            for _ in range(30):
                if H.ollama_up():
                    break
                time.sleep(1)
            else:
                return "the AI service didn't start"
            req = H.urllib.request.Request(H.OLLAMA + "/api/pull", data=H.json.dumps({"model": model}).encode(),
                                           headers={"Content-Type": "application/json"})
            with H.urllib.request.urlopen(req, timeout=3600) as r:
                for line in r:
                    msg = H.json.loads(line)
                    if msg.get("error"):
                        return msg["error"]
                    if msg.get("total"):
                        self.bridge.progress.emit(int(msg.get("completed", 0) * 100 // msg["total"]),
                                                  msg.get("status", ""))
            return True
        self.in_thread("setup", work)

    def on_progress(self, pct, text):
        self.bar.setRange(0, 100)
        self.bar.setValue(pct)
        self.status.setText(f"Setting up the AI on this PC: {text} ({pct}%)")

    # ---- background work ------------------------------------------------------------------
    def in_thread(self, name, fn, *args):
        def work():
            try:
                self.bridge.done.emit(name, ("ok", fn(*args)))
            except Exception as e:  # noqa: BLE001 - shown in plain words
                self.bridge.done.emit(name, ("error", str(e)))
        threading.Thread(target=work, daemon=True).start()

    def on_done(self, name, result):
        kind, value = result
        if name == "mail":
            self.thinking = False
            if kind != "ok":
                self.mood("worried")
                self.mail_talk.pending = None
                return self.answer({"reply": f"Sorry, that didn't work: {value}"}, keep=False)
            step, data = value
            return self.mail_step(self.mail_talk.done(step, data))
        if name == "mail-event":
            text = self.mail_talk.announce(value) if kind == "ok" else ""
            if text and not self.thinking and not self.ears.recording():
                self.answer({"reply": text}, keep=False)
            return
        if name == "mail-status":
            if kind == "ok" and value:
                self.mail_accounts = value.get("accounts", [])
            return
        if name == "agenda":
            self.thinking = False
            return self.answer({"reply": value if kind == "ok" else "I couldn't read your calendar just now."},
                               keep=False)
        if name == "aside":
            self.thinking = False
            if kind == "ok" and value.get("reply"):
                value["remember"], value["forget"] = [], []
                self.answer(value)
            return
        if name == "lookup":
            query, found = value if kind == "ok" else ("", None)
            ep, private = self.ai()
            if kind != "ok" or not ep:
                self.thinking = False
                self.mood("worried")
                self.status.setText("I couldn't reach the internet just now." if kind != "ok" else "")
                return
            if found and found.get("url"):
                self.small(f"Source: {found['source']}  ({found['url']})")
            elif found:
                self.small(f"Source: {found['source']}")
            self.in_thread("looked", self.run_ai, ep, self.messages(private is True, brain.lookup_turn(found, query, self.last_said())))
            return
        if name == "looked":
            self.thinking = False
            if kind == "ok":
                value.update(remember=[], forget=[], lookup=None)     # no chains of look-ups
                self.answer(value)
            else:
                self.mood("worried")
                self.status.setText(f"The AI didn't answer ({value[:120]}).")
            return
        if name == "eye-open":
            if kind == "ok" and value:
                self.avatar_size(True)
                self.eye_box.show()
                self.eye_timer.start()
                self.eye_tick()
            else:
                self.see.setChecked(False)
                self.first_look = True
                self.status.setText("The webcam couldn't be opened. Is another app using it?")
            return
        if name == "look":
            self.eye_busy = False
            if self.eye_close and self.cam:
                self.cam.close()
                self.cam, self.eye_close = None, False
                return
            if kind == "ok" and value and self.see.isChecked():
                self.saw(value)
            else:
                self.first_look = True
            return
        if name == "describe":
            self.describing = False
            if kind == "ok":
                self.described(value)
            return
        if name == "changed":
            self.describing = False
            if kind == "ok":
                pid, what, look = value
                self.people.set_look(pid, look)
                if what:
                    self.changes[pid] = what
            return
        if name in ("chat", "opener"):
            said = self.chat[-1]["content"] if self.chat and self.chat[-1]["role"] == "user" else ""
            if kind == "ok":
                self.answer(value, said=said)
            elif name == "opener":
                self.answer({"reply": f"Hi{', ' + self.me['name'] if self.me.get('name') else ''}! "
                                      "What's on your mind?"})
            else:
                self.thinking = False
                self.mood("worried")
                self.status.setText(f"The AI didn't answer ({value[:120]}).")
        elif name == "stt":
            self.talk_btn.setEnabled(True)
            self.status.setText("")
            if kind == "ok" and value:
                self.said(value)
            else:
                self.mood("worried")
                self.status.setText("Sorry, I didn't catch that. Try again?")
        elif name == "stt-dl":
            self.talk_btn.setEnabled(True)
            self.status.setText("Ready! Hold “Hold to talk” and talk to me." if kind == "ok" else
                                f"The speech model didn't download ({value}).")
        elif name == "voice-dl":
            self.status.setText("" if kind == "ok" else f"My voice didn't download ({value}).")
            if kind != "ok":
                self.talk.setChecked(False)
        elif name == "voice-synth" and kind == "ok":
            path, self.levels = value
            self.level_i = 0
            self.voice.play(path)
            self.speech.start()
        elif name == "name-heard" and self.name_dialog:
            self.name_dialog.heard(kind, value)
        elif name == "setup":
            self.bar.hide()
            self.status.setText("The AI on this PC is ready. Let's talk!" if kind == "ok" and value is True
                                else f"Setting up the AI didn't finish: {value}")

    # ---- Meta+K: talk from anywhere ------------------------------------------------------------
    def come_forward(self):
        # On Wayland a minimised window can't bring itself back, so a hidden or minimised
        # window is opened afresh, which the desktop always shows.
        if self.isMinimized() or not self.isVisible():
            self.hide()
            self.setWindowState(Qt.WindowState.WindowNoState)
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def listen_key(self):
        """Pressed once: she comes forward and listens. Pressed again: she stops and answers."""
        self.come_forward()
        if self.ears.recording():
            self.stop_listening()
            return
        if not self.ears.ready() or not H.Ears.available():
            return self.talk_pressed()             # offers the download
        cue = "/usr/share/sounds/freedesktop/stereo/message.oga"
        if os.path.exists(cue):
            subprocess.Popen(["pw-play", cue], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.talk_pressed()
        self.listen_toggle = True
        self.talk_btn.setText("Listening… press Meta+K again when done")

    def closeEvent(self, event):
        if self.mailbox:
            self.mailbox.stop()
        self.stop_eyes()
        self.voice.stop()
        if self.ears.recording():
            self.ears.stop()
        super().closeEvent(event)


