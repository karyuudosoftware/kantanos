#!/usr/bin/python3
"""Kan-chan: the KantanOS companion.

A character who lives on the PC: chat by talking or typing, she keeps notes about you (in a
database in your home folder, all visible and editable in "What I remember"), brings things
up, helps with everyday things like what to cook, and hands PC problems to the KantanOS
Helper. Her voice, ears, name and AI settings are shared with the Helper.

  kanchan            open her window
  kanchan --enable   put her in the app menu (Welcome does this), then open
  kanchan --disable  take her out of the app menu again (notes are kept)
"""
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import threading
import time
import urllib.parse

sys.path.insert(0, "/usr/share/kantanos/kanchan")
import brain  # noqa: E402

HELPER = "/usr/libexec/kantanos/helper"


def load_helper():
    loader = importlib.machinery.SourceFileLoader("kantanos_helper", os.environ.get("KANTAN_HELPER_PATH", HELPER))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("kantanos_helper", loader))
    loader.exec_module(mod)
    return mod


H = load_helper()           # Voice, Ears, Avatar, NameDialog, Settings, AI settings and more

from PySide6.QtCore import Qt, QTimer  # noqa: E402
from PySide6.QtGui import QFont, QIcon  # noqa: E402
from PySide6.QtWidgets import (QApplication, QCheckBox, QDialog, QDialogButtonBox, QFrame,  # noqa: E402
                               QHBoxLayout, QInputDialog, QLabel, QLineEdit, QListWidget,
                               QListWidgetItem, QMessageBox, QProgressBar, QPushButton, QScrollArea,
                               QVBoxLayout, QWidget)

TITLE = "Kan-chan"
DESKTOP = "kantanos-kanchan.desktop"
USER_APPS = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(H.HOME, ".local", "share")), "applications")


def set_in_menu(on):
    """The app menu entry is hidden until someone switches her on (Welcome)."""
    path = os.path.join(USER_APPS, DESKTOP)
    if not on:
        try:
            os.remove(path)
        except OSError:
            pass
        return
    with open("/usr/share/applications/" + DESKTOP, encoding="utf-8") as f:
        text = f.read()
    os.makedirs(USER_APPS, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(re.sub(r"(?m)^NoDisplay=true\n", "", text))
    subprocess.run(["kbuildsycoca6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Remembered(QDialog):
    """What I remember: every note, which you can add to, change or delete."""

    def __init__(self, parent, memory, person):
        super().__init__(parent)
        self.mem = memory
        self.setWindowTitle("What I remember")
        self.resize(560, 480)
        lay = QVBoxLayout(self)
        about = QLabel(f"Everything I keep about {person or 'you'} is here, and only on this PC. Change or "
                       "delete anything; you can also just tell me “remember …” or “forget …”.")
        about.setWordWrap(True)
        lay.addWidget(about)
        self.list = QListWidget()
        self.list.itemDoubleClicked.connect(lambda _: self.edit())
        lay.addWidget(self.list, 1)
        row = QHBoxLayout()
        for text, icon, fn in (("Add…", "list-add", self.add), ("Change…", "document-edit", self.edit),
                               ("Delete", "edit-delete", self.delete)):
            b = QPushButton(QIcon.fromTheme(icon), text)
            b.clicked.connect(fn)
            row.addWidget(b)
        row.addStretch()
        wipe = QPushButton(QIcon.fromTheme("edit-clear-all"), "Forget everything…")
        wipe.clicked.connect(self.wipe)
        row.addWidget(wipe)
        lay.addLayout(row)
        close = QDialogButtonBox(QDialogButtonBox.Close)
        close.rejected.connect(self.reject)
        lay.addWidget(close)
        self.fill()

    def fill(self):
        self.list.clear()
        notes = self.mem.all()
        for n in notes:
            when = n["created"][:10]
            item = QListWidgetItem(f"{n['text']}    ({'plan, ' if n['kind'] == 'plan' else ''}{when})")
            item.setData(Qt.UserRole, n["id"])
            self.list.addItem(item)
        if not notes:
            item = QListWidgetItem("Nothing yet. Tell me about yourself!")
            item.setFlags(Qt.NoItemFlags)
            self.list.addItem(item)

    def current(self):
        item = self.list.currentItem()
        return item.data(Qt.UserRole) if item else None

    def add(self):
        text, ok = QInputDialog.getText(self, "Add a note", "What should I remember?")
        if ok and text.strip():
            self.mem.add(text)
            self.fill()

    def edit(self):
        nid = self.current()
        note = self.mem.get(nid) if nid else None
        if not note:
            return
        text, ok = QInputDialog.getText(self, "Change a note", "Note:", text=note["text"])
        if ok and text.strip():
            self.mem.update(nid, text)
            self.fill()

    def delete(self):
        nid = self.current()
        if nid:
            self.mem.delete(nid)
            self.fill()

    def wipe(self):
        if QMessageBox.question(self, TITLE, "Forget everything I've noted? This can't be undone.",
                                QMessageBox.Yes | QMessageBox.No, QMessageBox.No) == QMessageBox.Yes:
            self.mem.clear()
            self.fill()


