def set_in_menu(on):
    """The app menu entry is hidden until someone switches her on (Welcome)."""
    path = os.path.join(USER_APPS, DESKTOP)
    if not on:
        try:
            os.remove(path)
        except OSError:
            pass
        return
    with open("/usr/share/applications/" + DESKTOP, encoding="utf-8") as f:
        text = f.read()
    os.makedirs(USER_APPS, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(re.sub(r"(?m)^NoDisplay=true\n", "", text))
    subprocess.run(["kbuildsycoca6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_check_in(on):
    """The daily hello runs at login from the person's own autostart folder (only when on)."""
    if not on:
        try:
            os.remove(AUTOSTART)
        except OSError:
            pass
        return
    os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
    with open(AUTOSTART, "w", encoding="utf-8") as f:
        f.write("[Desktop Entry]\nType=Application\nName=Kan-chan daily hello\n"
                "Exec=/usr/libexec/kantanos/kanchan --check-in\nIcon=kantanos-kanchan\n"
                "NoDisplay=true\nX-KDE-autostart-phase=2\n")


BUDDY = "org.kantanos.kanchan"


def desktop_script(js):
    """Runs a Plasma desktop script (as the signed-in person); returns what it prints."""
    out = subprocess.run(["busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
                          "org.kde.PlasmaShell", "evaluateScript", "s", js],
                         capture_output=True, text=True, timeout=20).stdout.strip()
    return out[3:-1].replace("\\n", "\n") if out.startswith('s "') else out


def buddy_on_desktop():
    js = ('var n = 0; var ds = desktops(); for (var i = 0; i < ds.length; i++) '
          '{ n += ds[i].widgets("%s").length; } print(n);' % BUDDY)
    try:
        return desktop_script(js).strip().startswith(("1", "2", "3"))
    except (OSError, subprocess.SubprocessError):
        return False


def set_buddy(on):
    """Kan-chan sits on the desktop (bottom right, above the dock) or leaves it."""
    if on:
        js = ('var d = desktopForScreen(0) || desktops()[0]; var g = screenGeometry(0); '
              'if (d.widgets("%s").length == 0) { d.addWidget("%s", g.width - 300, g.height - 470, 220, 300); }'
              % (BUDDY, BUDDY))
    else:
        js = ('var ds = desktops(); for (var i = 0; i < ds.length; i++) { var ws = ds[i].widgets("%s"); '
              'for (var j = 0; j < ws.length; j++) ws[j].remove(); }' % BUDDY)
    try:
        desktop_script(js)
    except (OSError, subprocess.SubprocessError):
        pass


def check_in():
    """Once a day, a short hello as a notification; a plan for today or tomorrow if there is one."""
    import datetime
    cfg = H.load()
    if not cfg.get("kanchan_checkin"):
        return
    today = datetime.date.today().isoformat()
    if cfg.get("kanchan_checkin_day") == today:
        return
    cfg["kanchan_checkin_day"] = today
    H.save(cfg)
    time.sleep(int(os.environ.get("KANTAN_CHECKIN_DELAY", "20")))      # let the desktop settle
    me = H.load_me()
    mem = brain.Memory(os.environ.get("KANTAN_KANCHAN_DB", brain.DB))
    text = brain.check_in_text(me.get("name", ""), mem.all())
    try:                                          # her desktop buddy shows it in a speech bubble
        with open(os.path.join(os.path.dirname(brain.DB), "buddy.txt"), "w", encoding="utf-8") as f:
            f.write(text)
    except OSError:
        pass
    out = subprocess.run(["notify-send", "-a", TITLE, "-i", "kantanos-kanchan", "-t", "30000", "-A", "talk=Talk to Kan-chan",
                          TITLE, text], capture_output=True, text=True).stdout.strip()
    if out == "talk":            # become her window (a child process could be cleaned up with this one)
        os.environ["KANTAN_KANCHAN_HELLO"] = text            # she carries on from her hello
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)])


class CharacterMaker(QDialog):
    """Make your own character: name, look, personality style and voice."""

    def __init__(self, parent, cfg):
        super().__init__(parent)
        self.setWindowTitle("Make a character")
        self.cfg = cfg
        self.result_pack = None
        self.picture = None
        mine = H.character_dir(maker.MINE)
        info = maker.load(mine) if mine else {}
        look, style = info.get("look") or {}, info.get("style") or {}
        lay = QHBoxLayout(self)
        self.preview = QLabel()
        self.preview.setFixedSize(200, 250)
        self.preview.setAlignment(Qt.AlignCenter)
        lay.addWidget(self.preview, 0, Qt.AlignTop)
        form = QFormLayout()
        lay.addLayout(form, 1)
        about = QLabel("Make your own companion. Whatever you choose, the rules stay the same: facts "
                       "first, fair on every side, and your notes stay on this PC.")
        about.setWordWrap(True)
        form.addRow(about)
        self.name = QLineEdit(info.get("name", ""))
        self.name.setPlaceholderText("For example: Pochi")
        self.name.setMaxLength(30)
        form.addRow("Name:", self.name)
        self.recolour = QRadioButton("Kan-chan's look, in these colours:")
        self.own = QRadioButton("My own picture…")
        self.recolour.setChecked(True)
        form.addRow(self.recolour)
        self.combos = {}
        for key, label, options in (("hair", "Hair", maker.HAIR), ("top", "Hoodie", maker.TOP),
                                    ("eyes", "Eyes", maker.EYES), ("skin", "Skin", maker.SKIN)):
            box = QComboBox()
            box.addItems(list(options))
            box.setCurrentText(look.get(key, next(iter(options))))
            box.currentTextChanged.connect(self.show_preview)
            self.combos[key] = box
            form.addRow(label + ":", box)
        prow = QHBoxLayout()
        prow.addWidget(self.own)
        pick = QPushButton(QIcon.fromTheme("document-open"), "Choose…")
        pick.clicked.connect(self.choose_picture)
        prow.addWidget(pick)
        prow.addStretch()
        form.addRow(prow)
        self.own.toggled.connect(self.show_preview)
        self.mood = QComboBox()
        self.mood.addItems(list(maker.MOODS))
        self.mood.setCurrentText(style.get("mood", next(iter(maker.MOODS))))
        form.addRow("Personality:", self.mood)
        self.length = QComboBox()
        self.length.addItems(list(maker.LENGTHS))
        self.length.setCurrentText(style.get("length", next(iter(maker.LENGTHS))))
        form.addRow("Talks:", self.length)
        self.extra = QLineEdit(style.get("extra", ""))
        self.extra.setMaxLength(200)
        self.extra.setPlaceholderText("Anything else? e.g. loves trains, says “yatta!” when happy")
        form.addRow("And:", self.extra)
        vrow = QHBoxLayout()
        self.voice = QComboBox()
        self.voice.addItems(list(maker.VOICES))
        current = info.get("voice", "")
        for label, vid in maker.VOICES.items():
            if vid == current:
                self.voice.setCurrentText(label)
        vrow.addWidget(self.voice, 1)
        hear = QPushButton(QIcon.fromTheme("media-playback-start"), "Hear it")
        hear.clicked.connect(self.hear)
        vrow.addWidget(hear)
        form.addRow("Voice:", vrow)
        self.note = QLabel()
        self.note.setWordWrap(True)
        self.note.setStyleSheet("color: palette(placeholder-text);")
        form.addRow(self.note)
        buttons = QDialogButtonBox()
        save = buttons.addButton("Save and use", QDialogButtonBox.AcceptRole)
        back = buttons.addButton("Back to Kan-chan", QDialogButtonBox.ResetRole)
        buttons.addButton(QDialogButtonBox.Cancel)
        save.clicked.connect(self.save)
        back.clicked.connect(self.back)
        buttons.rejected.connect(self.reject)
        form.addRow(buttons)
        self.voice_job = None
        self.voice_timer = QTimer(self, interval=500, timeout=self.voice_check)
        self.show_preview()

    def look(self):
        return {k: b.currentText() for k, b in self.combos.items()}

    def show_preview(self, *_):
        if self.own.isChecked() and self.picture:
            pix = QPixmap(self.picture)
        else:
            with open(os.path.join(maker.BUILT_IN, "happy.svg"), encoding="utf-8") as f:
                svg = maker.recolour(f.read(), **self.look())
            pix = QPixmap(self.preview.size() * 2)
            pix.fill(Qt.transparent)
            paint = QPainter(pix)
            QSvgRenderer(svg.encode()).render(paint)
            paint.end()
        self.preview.setPixmap(pix.scaled(self.preview.size(), Qt.KeepAspectRatio, Qt.SmoothTransformation))
        for b in self.combos.values():
            b.setEnabled(not self.own.isChecked())

    def choose_picture(self):
        path, _ = QFileDialog.getOpenFileName(self, "Choose a picture", H.HOME, "Pictures (*.png *.jpg *.jpeg *.svg)")
        if path:
            if not path.lower().endswith((".png", ".svg")):          # keep a PNG copy of photos
                out = os.path.join(H.DATA, "picture.png")
                os.makedirs(H.DATA, exist_ok=True)
                QPixmap(path).save(out, "PNG")
                path = out
            self.picture = path
            self.own.setChecked(True)
            self.show_preview()

    def hear(self):
        v = H.Voice(maker.VOICES[self.voice.currentText()])
        if not v.ready():
            if QMessageBox.question(self, TITLE, f"This voice needs a one-time download of {v.download_note}. "
                                    "Download it now?") != QMessageBox.Yes:
                return
            self.note.setText("Downloading the voice…")
        else:
            self.note.setText("")
        text = f"Hi! I'm {maker.clean_name(self.name.text())}. Nice to meet you!"

        def job():
            try:
                if not v.ready():
                    v.download()
                self.voice_job = ("ok", v, v.synthesize(text))
            except Exception as e:  # noqa: BLE001 - shown in plain words
                self.voice_job = ("error", v, str(e))
        self.voice_job = None
        threading.Thread(target=job, daemon=True).start()
        self.voice_timer.start()

    def voice_check(self):
        if not self.voice_job:
            return
        self.voice_timer.stop()
        kind, v, value = self.voice_job
        if kind == "ok":
            self.note.setText("")
            v.play(value[0])
        else:
            self.note.setText(f"The voice couldn't be played ({value[:80]}).")

    def save(self):
        if self.own.isChecked() and not self.picture:
            self.note.setText("Choose a picture first, or pick Kan-chan's look.")
            return
        style = {"mood": self.mood.currentText(), "length": self.length.currentText(), "extra": self.extra.text()}
        voice = maker.VOICES[self.voice.currentText()]
        self.result_pack = maker.save(os.path.join(H.DATA, "characters"), self.name.text(), self.look(), style,
                                      voice, self.picture if self.own.isChecked() else None)
        self.cfg["character"] = maker.MINE
        self.cfg["voice"] = voice
        H.save(self.cfg)
        self.accept()

    def back(self):
        self.cfg["character"] = "kan-chan"
        self.cfg.pop("voice", None)
        H.save(self.cfg)
        self.accept()


class Remembered(QDialog):
    """What I remember: every note, which you can add to, change or delete."""

    def __init__(self, parent, memory, person, people=None, acts=None, cfg=None):
        super().__init__(parent)
        self.mem = memory
        self.people = people
        self.acts, self.cfg = acts, cfg
        self.setWindowTitle("What I remember")
        self.resize(560, 480)
        lay = QVBoxLayout(self)
        about = QLabel(f"Everything I keep about {person or 'you'} is here, and only on this PC. Change or "
                       "delete anything; you can also just tell me “remember …” or “forget …”.")
        about.setWordWrap(True)
        lay.addWidget(about)
        self.list = QListWidget()
        self.list.itemDoubleClicked.connect(lambda _: self.edit())
        lay.addWidget(self.list, 1)
        row = QHBoxLayout()
        for text, icon, fn in (("Add…", "list-add", self.add), ("Change…", "document-edit", self.edit),
                               ("Delete", "edit-delete", self.delete)):
            b = QPushButton(QIcon.fromTheme(icon), text)
            b.clicked.connect(fn)
            row.addWidget(b)
        row.addStretch()
        wipe = QPushButton(QIcon.fromTheme("edit-clear-all"), "Forget everything…")
        wipe.clicked.connect(self.wipe)
        row.addWidget(wipe)
        lay.addLayout(row)
        if people is not None and people.all():
            lay.addWidget(QLabel("People I know by sight (a face fingerprint and how they looked; no photos):"))
            self.faces = QListWidget()
            self.faces.setMaximumHeight(140)
            self.faces.setWordWrap(True)
            lay.addWidget(self.faces)
            prow = QHBoxLayout()
            for text, icon, fn in (("Rename…", "document-edit", self.rename_person),
                                   ("Forget this face", "edit-delete", self.forget_person)):
                b = QPushButton(QIcon.fromTheme(icon), text)
                b.clicked.connect(fn)
                prow.addWidget(b)
            prow.addStretch()
            lay.addLayout(prow)
            self.fill_people()
        if acts is not None and cfg is not None:
            lay.addWidget(QLabel("Games and shows I've noticed (titles and time only, kept 30 days):"))
            nrow = QHBoxLayout()
            self.n_games = QCheckBox("Notice the games I play")
            self.n_shows = QCheckBox("Notice the shows and films I watch")
            self.n_games.setChecked(bool(cfg.get("kanchan_notice_games")))
            self.n_shows.setChecked(bool(cfg.get("kanchan_notice_shows")))
            for box in (self.n_games, self.n_shows):
                box.toggled.connect(self.noticing)
                nrow.addWidget(box)
            nrow.addStretch()
            lay.addLayout(nrow)
            self.noticed = QListWidget()
            self.noticed.setMaximumHeight(120)
            lay.addWidget(self.noticed)
            forget = QPushButton(QIcon.fromTheme("edit-delete"), "Forget this one")
            forget.clicked.connect(self.forget_noticed)
            frow = QHBoxLayout()
            frow.addWidget(forget)
            frow.addStretch()
            lay.addLayout(frow)
            self.fill_noticed()
        close = QDialogButtonBox(QDialogButtonBox.Close)
        close.rejected.connect(self.reject)
        lay.addWidget(close)
        self.fill()

    def fill(self):
        self.list.clear()
        notes = self.mem.all()
        for n in notes:
            when = n["created"][:10]
            item = QListWidgetItem(f"{n['text']}    ({'plan, ' if n['kind'] == 'plan' else ''}{when})")
            item.setData(Qt.UserRole, n["id"])
            self.list.addItem(item)
        if not notes:
            item = QListWidgetItem("Nothing yet. Tell me about yourself!")
            item.setFlags(Qt.NoItemFlags)
            self.list.addItem(item)

    def fill_people(self):
        self.faces.clear()
        for p in self.people.all():
            seen = f"last seen {p['seen'][:10]}" if p.get("seen") else "not seen yet"
            look = f"; {p['look']}" if p.get("look") else ""
            item = QListWidgetItem(f"{p['name']}    ({seen}{look})")
            item.setToolTip(p.get("look") or "")
            item.setData(Qt.UserRole, p["id"])
            self.faces.addItem(item)

    def fill_noticed(self):
        self.noticed.clear()
        items = self.acts.recent(days=30)
        for a in items:
            what = "Played" if a["kind"] == "game" else "Watched"
            item = QListWidgetItem(f"{what}: {a['title']}    ({brain.when_text(a['last'])}, {a['minutes']} min)")
            item.setData(Qt.UserRole, (a["kind"], a["title"]))
            self.noticed.addItem(item)
        if not items:
            item = QListWidgetItem("Nothing yet." if self.n_games.isChecked() or self.n_shows.isChecked()
                                   else "Switched off.")
            item.setFlags(Qt.NoItemFlags)
            self.noticed.addItem(item)

    def noticing(self):
        self.cfg["kanchan_notice_games"] = self.n_games.isChecked()
        self.cfg["kanchan_notice_shows"] = self.n_shows.isChecked()
        H.save(self.cfg)
        on = self.n_games.isChecked() or self.n_shows.isChecked()
        subprocess.run(["systemctl", "--user", "enable" if on else "disable", "--now", NOTICE_UNIT],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not on and self.acts.recent(days=30) and QMessageBox.question(
                self, TITLE, "Also forget the games and shows I've noticed so far?",
                QMessageBox.Yes | QMessageBox.No) == QMessageBox.Yes:
            self.acts.clear()
        self.fill_noticed()

    def forget_noticed(self):
        item = self.noticed.currentItem()
        data = item.data(Qt.UserRole) if item else None
        if data:
            self.acts.forget(*data)
            self.fill_noticed()

    def rename_person(self):
        item = self.faces.currentItem()
        p = self.people.get(item.data(Qt.UserRole)) if item else None
        if p:
            name, ok = QInputDialog.getText(self, "Rename", "Name:", text=p["name"])
            if ok and name.strip():
                self.people.rename(p["id"], name)
                self.fill_people()

    def forget_person(self):
        item = self.faces.currentItem()
        if item:
            self.people.delete(item.data(Qt.UserRole))
            self.fill_people()

    def current(self):
        item = self.list.currentItem()
        return item.data(Qt.UserRole) if item else None

    def add(self):
        text, ok = QInputDialog.getText(self, "Add a note", "What should I remember?")
        if ok and text.strip():
            self.mem.add(text)
            self.fill()

    def edit(self):
        nid = self.current()
        note = self.mem.get(nid) if nid else None
        if not note:
            return
        text, ok = QInputDialog.getText(self, "Change a note", "Note:", text=note["text"])
        if ok and text.strip():
            self.mem.update(nid, text)
            self.fill()

    def delete(self):
        nid = self.current()
        if nid:
            self.mem.delete(nid)
            self.fill()

    def wipe(self):
        if QMessageBox.question(self, TITLE, "Forget everything I've noted, and everyone's face? This can't be "
                                "undone.", QMessageBox.Yes | QMessageBox.No, QMessageBox.No) == QMessageBox.Yes:
            self.mem.clear()
            if self.acts is not None:
                self.acts.clear()
                if hasattr(self, "noticed"):
                    self.fill_noticed()
            if self.people is not None:
                self.people.clear()
                if hasattr(self, "faces"):
                    self.fill_people()
            self.fill()


