    def refresh(self):
        installed = mail.thunderbird_installed()
        prof = mail.profile() if installed else ""
        added = mail.addon_installed(prof)
        b = self.owner.mailbox
        self.tb_btn.setText("Open Thunderbird" if installed else "Install Thunderbird")
        self.connect_btn.setVisible(installed and bool(prof) and not added)
        self.off_btn.setVisible(added)
        if not installed:
            text = "Step 1: install Thunderbird, then add the email account in it."
        elif not prof:
            text = "Step 1: open Thunderbird and add the email account (Outlook and Gmail sign in on their own page)."
        elif not added:
            text = "Step 2: once the account works in Thunderbird, press “Connect me to Thunderbird”."
        elif b and b.connected():
            accounts = self.owner.mail_accounts
            text = "✅ Connected" + (f": {', '.join(accounts)}." if accounts else ".") + \
                   " Try saying “have I got any emails?”."
        elif mail.thunderbird_running():
            text = "Connected, but Thunderbird needs closing and opening again before I can use it."
        else:
            text = "Connected. Thunderbird needs to be open for me to read your email (I'll open it when you ask)."
        self.mail_state.setText(text)

    def thunderbird(self):
        if mail.thunderbird_installed():
            mail.open_thunderbird()
            return
        self.mail_state.setText("Installing Thunderbird… (a few minutes)")
        self.tb_btn.setEnabled(False)

        def done():
            subprocess.run(["kantan-app", "install", mail.THUNDERBIRD], capture_output=True)
            QTimer.singleShot(0, lambda: self.tb_btn.setEnabled(True))
        threading.Thread(target=done, daemon=True).start()

    def connect_mail(self):
        try:
            why = mail.install_addon()
        except (OSError, ValueError) as e:
            why = f"I couldn't connect to Thunderbird ({e})."
        if why:
            self.mail_state.setText(why)
            return
        self.cfg["kanchan_mail"] = True
        H.save(self.cfg)
        self.owner.start_mail()
        if mail.thunderbird_running():
            QMessageBox.information(self, TITLE, "Nearly done: close Thunderbird and open it again, so my email "
                                                 "helper starts inside it.")
        self.refresh()

    def disconnect_mail(self):
        mail.remove_addon()
        self.cfg["kanchan_mail"] = False
        H.save(self.cfg)
        self.refresh()

    def save_sign(self):
        self.cfg["kanchan_mail_sign"] = self.sign.text().strip()
        H.save(self.cfg)
        self.owner.mail_talk.signature = self.cfg["kanchan_mail_sign"]

    def fill_links(self):
        self.links.clear()
        for link in self.cfg.get("calendar_links", []):
            host = urllib.parse.urlparse(link["url"]).hostname or "calendar"
            self.links.addItem(f"{link.get('name') or 'Calendar'} ({host}, private link)")

    def add_link(self):
        url = agenda.clean_link(self.link_entry.text())
        if not url:
            self.cal_state.setText("That doesn't look like a calendar link. It should start with https:// or webcal://.")
            return
        self.cal_state.setText("Reading the calendar…")
        QApplication.processEvents()
        import datetime
        now = datetime.datetime.now().astimezone()
        try:
            text = agenda.fetch(url, force=True)
            import icalendar
            name = str(icalendar.Calendar.from_ical(text).get("X-WR-CALNAME", "")).strip() or "Calendar"
            evs = agenda.events(text, now, now + datetime.timedelta(days=14))
        except Exception as e:  # noqa: BLE001 - shown in plain words
            self.cal_state.setText(f"I couldn't read that calendar ({str(e)[:100]}). Is the link complete?")
            return
        links = [l for l in self.cfg.get("calendar_links", []) if l["url"] != url] + [{"name": name, "url": url}]
        self.cfg["calendar_links"] = links
        H.save(self.cfg)
        self.link_entry.clear()
        self.fill_links()
        set_reminders(True)
        if evs:
            days = (evs[0]["start"].date() - datetime.date.today()).days
            on = "today" if days == 0 else "tomorrow" if days == 1 else "on " + evs[0]["start"].strftime("%A")
            nxt = f" The next one: {agenda.describe(evs[0])} {on}."
        else:
            nxt = ""
        self.cal_state.setText(f"✅ Added “{name}”: {len(evs)} appointment(s) in the next two weeks.{nxt}")

    def remove_link(self):
        i = self.links.currentRow()
        links = self.cfg.get("calendar_links", [])
        if i < 0 or i >= len(links):
            return
        links.pop(i)
        self.cfg["calendar_links"] = links
        H.save(self.cfg)
        self.fill_links()
        set_reminders(bool(links))
        self.cal_state.setText("Removed." + ("" if links else " Reminders are off until a calendar is added."))

    def speak_toggled(self, on):
        self.cfg["kanchan_remind_speak"] = on
        H.save(self.cfg)


