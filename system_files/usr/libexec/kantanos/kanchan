TEST_PRIVATE = bool(os.environ.get("KANTAN_KANCHAN_TEST_PRIVATE"))
USER_APPS = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(H.HOME, ".local", "share")), "applications")


def set_in_menu(on):
    """The app menu entry is hidden until someone switches her on (Welcome)."""
    path = os.path.join(USER_APPS, DESKTOP)
    if not on:
        try:
            os.remove(path)
        except OSError:
            pass
        return
    with open("/usr/share/applications/" + DESKTOP, encoding="utf-8") as f:
        text = f.read()
    os.makedirs(USER_APPS, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(re.sub(r"(?m)^NoDisplay=true\n", "", text))
    subprocess.run(["kbuildsycoca6"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Remembered(QDialog):
    """What I remember: every note, which you can add to, change or delete."""

    def __init__(self, parent, memory, person, people=None, acts=None, cfg=None):
        super().__init__(parent)
        self.mem = memory
        self.people = people
        self.acts, self.cfg = acts, cfg
        self.setWindowTitle("What I remember")
        self.resize(560, 480)
        lay = QVBoxLayout(self)
        about = QLabel(f"Everything I keep about {person or 'you'} is here, and only on this PC. Change or "
                       "delete anything; you can also just tell me “remember …” or “forget …”.")
        about.setWordWrap(True)
        lay.addWidget(about)
        self.list = QListWidget()
        self.list.itemDoubleClicked.connect(lambda _: self.edit())
        lay.addWidget(self.list, 1)
        row = QHBoxLayout()
        for text, icon, fn in (("Add…", "list-add", self.add), ("Change…", "document-edit", self.edit),
                               ("Delete", "edit-delete", self.delete)):
            b = QPushButton(QIcon.fromTheme(icon), text)
            b.clicked.connect(fn)
            row.addWidget(b)
        row.addStretch()
        wipe = QPushButton(QIcon.fromTheme("edit-clear-all"), "Forget everything…")
        wipe.clicked.connect(self.wipe)
        row.addWidget(wipe)
        lay.addLayout(row)
        if people is not None and people.all():
            lay.addWidget(QLabel("People I know by sight (a face fingerprint and how they looked; no photos):"))
            self.faces = QListWidget()
            self.faces.setMaximumHeight(140)
            self.faces.setWordWrap(True)
            lay.addWidget(self.faces)
            prow = QHBoxLayout()
            for text, icon, fn in (("Rename…", "document-edit", self.rename_person),
                                   ("Forget this face", "edit-delete", self.forget_person)):
                b = QPushButton(QIcon.fromTheme(icon), text)
                b.clicked.connect(fn)
                prow.addWidget(b)
            prow.addStretch()
            lay.addLayout(prow)
            self.fill_people()
        if acts is not None and cfg is not None:
            lay.addWidget(QLabel("Games and shows I've noticed (titles and time only, kept 30 days):"))
            nrow = QHBoxLayout()
            self.n_games = QCheckBox("Notice the games I play")
            self.n_shows = QCheckBox("Notice the shows and films I watch")
            self.n_games.setChecked(bool(cfg.get("kanchan_notice_games")))
            self.n_shows.setChecked(bool(cfg.get("kanchan_notice_shows")))
            for box in (self.n_games, self.n_shows):
                box.toggled.connect(self.noticing)
                nrow.addWidget(box)
            nrow.addStretch()
            lay.addLayout(nrow)
            self.noticed = QListWidget()
            self.noticed.setMaximumHeight(120)
            lay.addWidget(self.noticed)
            forget = QPushButton(QIcon.fromTheme("edit-delete"), "Forget this one")
            forget.clicked.connect(self.forget_noticed)
            frow = QHBoxLayout()
            frow.addWidget(forget)
            frow.addStretch()
            lay.addLayout(frow)
            self.fill_noticed()
        close = QDialogButtonBox(QDialogButtonBox.Close)
        close.rejected.connect(self.reject)
        lay.addWidget(close)
        self.fill()

    def fill(self):
        self.list.clear()
        notes = self.mem.all()
        for n in notes:
            when = n["created"][:10]
            item = QListWidgetItem(f"{n['text']}    ({'plan, ' if n['kind'] == 'plan' else ''}{when})")
            item.setData(Qt.UserRole, n["id"])
            self.list.addItem(item)
        if not notes:
            item = QListWidgetItem("Nothing yet. Tell me about yourself!")
            item.setFlags(Qt.NoItemFlags)
            self.list.addItem(item)

    def fill_people(self):
        self.faces.clear()
        for p in self.people.all():
            seen = f"last seen {p['seen'][:10]}" if p.get("seen") else "not seen yet"
            look = f"; {p['look']}" if p.get("look") else ""
            item = QListWidgetItem(f"{p['name']}    ({seen}{look})")
            item.setToolTip(p.get("look") or "")
            item.setData(Qt.UserRole, p["id"])
            self.faces.addItem(item)

    def fill_noticed(self):
        self.noticed.clear()
        items = self.acts.recent(days=30)
        for a in items:
            what = "Played" if a["kind"] == "game" else "Watched"
            item = QListWidgetItem(f"{what}: {a['title']}    ({brain.when_text(a['last'])}, {a['minutes']} min)")
            item.setData(Qt.UserRole, (a["kind"], a["title"]))
            self.noticed.addItem(item)
        if not items:
            item = QListWidgetItem("Nothing yet." if self.n_games.isChecked() or self.n_shows.isChecked()
                                   else "Switched off.")
            item.setFlags(Qt.NoItemFlags)
            self.noticed.addItem(item)

    def noticing(self):
        self.cfg["kanchan_notice_games"] = self.n_games.isChecked()
        self.cfg["kanchan_notice_shows"] = self.n_shows.isChecked()
        H.save(self.cfg)
        on = self.n_games.isChecked() or self.n_shows.isChecked()
        subprocess.run(["systemctl", "--user", "enable" if on else "disable", "--now", NOTICE_UNIT],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not on and self.acts.recent(days=30) and QMessageBox.question(
                self, TITLE, "Also forget the games and shows I've noticed so far?",
                QMessageBox.Yes | QMessageBox.No) == QMessageBox.Yes:
            self.acts.clear()
        self.fill_noticed()

    def forget_noticed(self):
        item = self.noticed.currentItem()
        data = item.data(Qt.UserRole) if item else None
        if data:
            self.acts.forget(*data)
            self.fill_noticed()

    def rename_person(self):
        item = self.faces.currentItem()
        p = self.people.get(item.data(Qt.UserRole)) if item else None
        if p:
            name, ok = QInputDialog.getText(self, "Rename", "Name:", text=p["name"])
            if ok and name.strip():
                self.people.rename(p["id"], name)
                self.fill_people()

    def forget_person(self):
        item = self.faces.currentItem()
        if item:
            self.people.delete(item.data(Qt.UserRole))
            self.fill_people()

    def current(self):
        item = self.list.currentItem()
        return item.data(Qt.UserRole) if item else None

    def add(self):
        text, ok = QInputDialog.getText(self, "Add a note", "What should I remember?")
        if ok and text.strip():
            self.mem.add(text)
            self.fill()

    def edit(self):
        nid = self.current()
        note = self.mem.get(nid) if nid else None
        if not note:
            return
        text, ok = QInputDialog.getText(self, "Change a note", "Note:", text=note["text"])
        if ok and text.strip():
            self.mem.update(nid, text)
            self.fill()

    def delete(self):
        nid = self.current()
        if nid:
            self.mem.delete(nid)
            self.fill()

    def wipe(self):
        if QMessageBox.question(self, TITLE, "Forget everything I've noted, and everyone's face? This can't be "
                                "undone.", QMessageBox.Yes | QMessageBox.No, QMessageBox.No) == QMessageBox.Yes:
            self.mem.clear()
            if self.acts is not None:
                self.acts.clear()
                if hasattr(self, "noticed"):
                    self.fill_noticed()
            if self.people is not None:
                self.people.clear()
                if hasattr(self, "faces"):
                    self.fill_people()
            self.fill()


