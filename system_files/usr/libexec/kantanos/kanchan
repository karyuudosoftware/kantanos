def load_helper():
    loader = importlib.machinery.SourceFileLoader("kantanos_helper", os.environ.get("KANTAN_HELPER_PATH", HELPER))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("kantanos_helper", loader))
    loader.exec_module(mod)
    return mod


