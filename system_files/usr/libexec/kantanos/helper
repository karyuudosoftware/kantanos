        if not self.chat:
            self.clear_results()
        self.bubble(text, True)
        self.chat.append({"role": "user", "content": text})
        provider = self.cfg.get("provider", "local")
        if provider == "online" and self.cfg.get("online_url"):
            if not self.chat_online_ok:
                host = urllib.parse.urlparse(self.cfg["online_url"]).hostname
                box = QMessageBox(self)
