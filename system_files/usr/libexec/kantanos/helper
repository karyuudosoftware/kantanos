class Avatar(QWidget):
    """Draws the character pack's frames: idle (gently bobbing, blinking), think, happy,
    worried, and talk1/talk2 while speaking. A pack is a folder of SVG or PNG files, or
    several outfits in looks/<name>/ worn by season, time of day and weather (looks.py),
    rechecked every 10 minutes.
    full=True (the Helper window): the whole of her, head to shoes, from looks/<name>/full/
    (idle.png plus small face pictures put on it, faces.json), standing still; packs without
    full pictures fall back to the head-to-hips frames."""

    def __init__(self, pack, context="", full=False):
        super().__init__()
        self.full = full
        self.setFixedSize(*((190, 440) if full else (132, 165)))
        self.pack, self.context, self.look = pack, context, None
        self.frames = {}
        self.scaled = {}                   # (frame, w, h) -> picture shrunk smoothly, once
        self.load_look()
        self.look_timer = QTimer(self, interval=10 * 60 * 1000, timeout=self.load_look)
        self.look_timer.start()
        self.mood = "idle"
        self.mouth = None                 # "talk1" / "talk2" while speaking
        self.blinking = False
        self.t0 = time.monotonic()
        self.tick = QTimer(self, interval=40, timeout=self.update)
        self.tick.start()
        self.blink_timer = QTimer(self, singleShot=True, timeout=self.blink)
        self.blink_timer.start(2500)

    def load_look(self):
        folder = looks.current(self.pack, self.context) if self.pack else None
        if folder == self.look and self.frames:
            return
        self.look, frames = folder, {}
        self.scaled = {}
        if self.full and folder and os.path.isfile(os.path.join(folder, "full", "idle.png")):
            self.frames = self.full_frames(os.path.join(folder, "full"))
            self.update()
            return
        if self.full:                      # no full pictures in this pack: the usual size
            self.full = False
            self.setFixedSize(132, 165)
        for name in ("idle", "blink", "talk1", "talk2", "think", "happy", "worried", "listen"):
            for ext in (".svg", ".png"):
                p = os.path.join(folder, name + ext) if folder else ""
                if p and os.path.isfile(p):
                    if ext == ".svg":
                        frames[name] = QSvgRenderer(p)
                    else:
                        from PySide6.QtGui import QPixmap
                        frames[name] = QPixmap(p)
                    break
        self.frames = frames
        self.update()

    @staticmethod
    def full_frames(folder):
        from PySide6.QtGui import QPixmap
        base = QPixmap(os.path.join(folder, "idle.png"))
        frames = {"idle": base}
        try:
            with open(os.path.join(folder, "faces.json"), encoding="utf-8") as f:
                faces = json.load(f)
        except (OSError, ValueError):
            faces = {}
        for name, (x, y) in faces.items():
            face = QPixmap(os.path.join(folder, name + ".png"))
            if face.isNull():
                continue
            pm = QPixmap(base)
            p = QPainter(pm)
            p.drawPixmap(int(x), int(y), face)
            p.end()
            frames[name] = pm
        return frames

    def blink(self):
        self.blinking = True
        QTimer.singleShot(140, self.unblink)

    def unblink(self):
        self.blinking = False
        self.blink_timer.start(random.randint(2500, 6000))

    def set_mood(self, mood):
        self.mood = mood

    def paintEvent(self, _):
        name = self.mouth or self.mood
        if name in ("idle", "talk1", "talk2") and self.blinking and not self.mouth:
            name = "blink"
        frame = self.frames.get(name) or self.frames.get("idle")
        if frame is None:
            return
        speed = 4.5 if self.mood == "listen" else 2.2          # a little livelier while listening
        bob = 0                                                  # the full-length picture stands still
        if not self.full and self.mood in ("idle", "think", "listen"):
            bob = math.sin((time.monotonic() - self.t0) * speed) * 2.5
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        target = QRectF(0, 3 + bob, self.width(), self.height() - 6)
        if isinstance(frame, QSvgRenderer):
            frame.render(p, target)
            return
        # shrunk once with proper smoothing (drawing a big picture small each time looks jagged),
        # at the screen's real pixel size, keeping her proportions
        dpr = self.devicePixelRatioF()
        key = (name if name in self.frames else "idle", self.width(), self.height(), dpr)
        pm = self.scaled.get(key)
        if pm is None:
            pm = frame.scaled(int(target.width() * dpr), int(target.height() * dpr),
                              Qt.KeepAspectRatio, Qt.SmoothTransformation)
            pm.setDevicePixelRatio(dpr)
            self.scaled[key] = pm
        w, h = pm.width() / dpr, pm.height() / dpr
        p.drawPixmap(QRectF(target.x() + (target.width() - w) / 2, target.y(), w, h), pm, QRectF(pm.rect()))


class Voice:
    """Speech on this PC. Two engines: Kokoro (Kan-chan's voice, ids like "kokoro-jf_tebukuro")
    and Piper (the other voices, ids like "en_US-hfc_female-medium"). The voice files download
    once into the home folder, after asking."""

    def __init__(self, name):
        self.name = name
        self.dir = os.path.join(DATA, "voices")
        self.kokoro = name.startswith("kokoro-")
        if self.kokoro:
            self.style = name.split("-", 1)[1]
            self.files = [os.path.join(self.dir, f) for f in KOKORO_FILES]
        else:
            self.model = os.path.join(self.dir, name + ".onnx")
            self.files = [self.model, self.model + ".json"]
        self.player = None

    @property
    def download_note(self):
        """For the "Download it now?" question."""
        if self.kokoro:
            return "about 200 MB (from the Kokoro voice library)"
        return "about 60 MB (from the Piper voice library)"

    @property
    def japanese(self):
        """Can this voice read Japanese? (Kokoro's Japanese voices also speak English.)"""
        return self.kokoro and self.style[:1] == "j"

    def ready(self):
        return all(os.path.isfile(f) for f in self.files)

    def download(self):
        os.makedirs(self.dir, exist_ok=True)
        if self.kokoro:
            for fname, digest in KOKORO_FILES.items():
                path = os.path.join(self.dir, fname)
                if os.path.isfile(path):
                    continue
                urllib.request.urlretrieve(f"{KOKORO_BASE}/{fname}", path + ".part")
                h = hashlib.sha256()
                with open(path + ".part", "rb") as f:
                    for block in iter(lambda: f.read(1 << 20), b""):
                        h.update(block)
                if h.hexdigest() != digest:
                    os.remove(path + ".part")
                    raise OSError("the download was incomplete")
                os.replace(path + ".part", path)
            return
        lang, speaker, quality = self.name.split("-")
        url = f"{VOICE_BASE}/{lang.split('_')[0]}/{lang}/{speaker}/{quality}/{self.name}.onnx"
        for suffix in (".onnx.json", ".onnx"):
            tmp = self.model.replace(".onnx", suffix) + ".part"
            urllib.request.urlretrieve(url.replace(".onnx", suffix), tmp)
            os.replace(tmp, self.model.replace(".onnx", suffix))

    _engine = None                  # Kokoro loaded once per program (about 1 second)
    _engine_lock = threading.Lock()

    def kokoro_wav(self, text, out):
        from kokoro_onnx import Kokoro
        with Voice._engine_lock:
            if Voice._engine is None:
                Voice._engine = Kokoro(*self.files)
            japanese = has_japanese(text)
            if japanese:
                samples, rate = Voice._engine.create(japanese_sounds(text), voice=self.style,
                                                     speed=KOKORO_PACE, is_phonemes=True)
            else:
                # Her name the Japanese way ("Kahn-chahn"), not the English "Can-chan"
                text = re.sub(r"(?<!\w)Kan-?chan(?!\w)", "Kahn-chahn", text, flags=re.I)
                samples, rate = Voice._engine.create(text, voice=self.style, speed=KOKORO_PACE, lang="en-us")
        import numpy
        pcm = (numpy.clip(samples, -1.0, 1.0) * 32767).astype("<i2").tobytes()
        with wave.open(out, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(rate)
            w.writeframes(pcm)

    def synthesize(self, text):
        """Returns (wav path, loudness per 40 ms) for the mouth to follow."""
        out = os.path.join(tempfile.gettempdir(), f"kantanos-helper-{os.getuid()}.wav")
        if self.kokoro:
            self.kokoro_wav(text, out)
        else:
            subprocess.run([sys.executable, "-m", "piper", "-m", self.model, "-f", out],
                           input=text, text=True, capture_output=True, timeout=120, check=True)
        with wave.open(out, "rb") as w:
            rate, width, frames = w.getframerate(), w.getsampwidth(), w.readframes(w.getnframes())
        step = int(rate * 0.04) * width
        levels = []
        for i in range(0, len(frames), step):
            chunk = frames[i:i + step]
            n = len(chunk) // 2
            if width != 2 or n == 0:
                levels.append(0.5)
                continue
            total = 0
            for j in range(0, n * 2, 8):                       # every 4th sample is plenty
                s = int.from_bytes(chunk[j:j + 2], "little", signed=True)
                total += s * s
            levels.append(math.sqrt(total / max(1, n // 4)) / 32768)
        peak = max(levels) if levels else 1
        return out, [l / peak if peak else 0 for l in levels]

    def play(self, path):
        self.stop()
        self.player = subprocess.Popen(["pw-play", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def stop(self):
        if self.player and self.player.poll() is None:
            self.player.terminate()


_ja_reader = None


def japanese_sounds(text):
    """Japanese text as Kokoro's sounds, read the way Kokoro's makers do it (misaki). misaki
    wants fugashi (no build for this Python) and mojimoji; the mecab command (Fedora's MeCab
    with the IPA dictionary) gives the same word readings, and NFKC, which misaki applies
    first anyway, already does mojimoji's full/half-width tidying. (espeak-ng reads こんにちは
    letter by letter and says "Chinese letter" for every kanji.)"""
    global _ja_reader
    if _ja_reader is None:
        import types

        class Feature:
            def __init__(self, pron, kana):
                self.pron, self.kana = pron, kana

        class Node:
            def __init__(self, surface, char_type, unknown, pron, kana):
                self.surface, self.char_type, self.is_unk = surface, char_type, unknown
                self.feature = Feature(pron, kana)

        def tag(line):
            # one word per row: word, character type, unknown?, reading, pronunciation
            out = subprocess.run(["mecab", "-F", r"%m\t%t\t%s\t%f[7]\t%f[8]\n", "-U", r"%m\t%t\t%s\t*\t*\n",
                                  "-E", ""], input=line.replace("\n", " ") + "\n", capture_output=True,
                                 text=True, timeout=30, check=True).stdout
            nodes = []
            for row in out.splitlines():
                p = row.split("\t")
                if len(p) == 5 and p[1].isdigit():
                    nodes.append(Node(p[0], int(p[1]), p[2] == "1", None if p[4] == "*" else p[4],
                                      None if p[3] == "*" else p[3]))
            return nodes

        sys.modules.setdefault("fugashi", types.SimpleNamespace(Tagger=lambda: tag))
        sys.modules.setdefault("mojimoji", types.SimpleNamespace(zen_to_han=lambda t, **_: t,
                                                                 han_to_zen=lambda t, **_: t))
        from misaki import ja
        _ja_reader = ja.JAG2P()
    sounds = _ja_reader(text)
    return re.sub(r"o ɯ(?=[ !?.,…]|$)", "oː", sounds)       # しよう: "shiyo u" -> "shiyō"


def speakable(text):
    return re.sub(r"[*_`#>•]", "", text).strip()


class Ears:
    """Speech to text with whisper.cpp (python3-pywhispercpp), entirely on this PC. The speech
    model downloads once into the home folder; each recording is deleted as soon as it has
    been understood. The microphone is only on while the Talk button is held (or until it is
    clicked again), never in the background.
    KANTAN_HELPER_FAKE_MIC=<file.wav> uses a recording instead of the microphone (for tests)."""

    def __init__(self):
        self.dir = os.path.join(DATA, "speech")
        self.model_path = os.path.join(self.dir, STT_MODEL)
        self.wav = os.path.join(tempfile.gettempdir(), f"kantanos-helper-mic-{os.getuid()}.wav")
        self.fake = os.environ.get("KANTAN_HELPER_FAKE_MIC", "")
        self.rec = None
        self.fake_on = False
        self._model = None

    @staticmethod
    def available():
        try:
            import pywhispercpp  # noqa: F401
        except ImportError:
            return False
        return bool(shutil.which("pw-record"))

    def ready(self):
        return os.path.isfile(self.model_path)

    def download(self):
        os.makedirs(self.dir, exist_ok=True)
        tmp = self.model_path + ".part"
        urllib.request.urlretrieve(STT_URL, tmp)
        if os.path.getsize(tmp) < 50_000_000:
            os.remove(tmp)
            raise OSError("the download was incomplete")
        os.replace(tmp, self.model_path)

    def start(self):
        if self.fake:
            self.fake_on = True
            return
        try:
            os.remove(self.wav)
        except OSError:
            pass
        self.rec = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16",
                                     "--media-role", "Communication", self.wav],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def recording(self):
        if self.fake:
            return self.fake_on
        return self.rec is not None and self.rec.poll() is None

    def stop(self):
        """Ends the recording; returns the file, or None when nothing was recorded."""
        if self.fake:
            self.fake_on = False
            return self.fake
        if self.rec is None:
            return None
        if self.rec.poll() is None:
            self.rec.send_signal(signal.SIGINT)        # pw-record finishes the file on SIGINT
            try:
                self.rec.wait(3)
            except subprocess.TimeoutExpired:
                self.rec.kill()
        self.rec = None
        ok = os.path.isfile(self.wav) and os.path.getsize(self.wav) > 16000   # > 0.5 s of sound
        return self.wav if ok else None

    def transcribe(self, path, me=None):
        """me: the person's name ({"name", "say"}), so it's heard and written the way they spell it.
        Leave it out when listening to how a name sounds."""
        import numpy as np
        from pywhispercpp.model import Model
        try:
            with wave.open(path, "rb") as w:
                rate, ch, width = w.getframerate(), w.getnchannels(), w.getsampwidth()
                raw = w.readframes(w.getnframes())
        finally:
            if path == self.wav:
                try:
                    os.remove(path)              # what was said is not kept
                except OSError:
                    pass
        if width != 2:
            raise ValueError("unexpected recording format")
        audio = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
        if ch > 1:
            audio = audio.reshape(-1, ch).mean(axis=1)
        if rate != 16000:                            # whisper wants 16 kHz
            n = int(len(audio) * 16000 / rate)
            audio = np.interp(np.linspace(0, len(audio) - 1, n), np.arange(len(audio)), audio).astype(np.float32)
        if len(audio) < 8000 or float(np.abs(audio).max()) < 0.01:
            return ""                                # too short or silent
        if self._model is None:
            self._model = Model(self.model_path, n_threads=max(2, min(8, (os.cpu_count() or 4) // 2)),
                                print_progress=False, print_realtime=False, redirect_whispercpp_logs_to=None)
        # The prompt teaches the recogniser her name and the PC's words.
        name, say = ((me or {}).get("name") or "").strip(), ((me or {}).get("say") or "").strip()
        prompt = "Kan-chan, KantanOS. かんちゃん、カンタンOS。" + (f" {name}." if name else "")
        segments = self._model.transcribe(audio, language="auto", initial_prompt=prompt)
        text = " ".join(s.text.strip() for s in segments)
        if name and say and say.lower() != name.lower():   # heard as it sounds, written as they spell it
            text = re.sub(name_words(say), name, text, flags=re.I)
        # Near-misses of her name at the start of a sentence.
        text = re.sub(r"^(hi|hey|hello|ok|okay)?[ ,]*\b(g|k|c)[ao]n+[ -]?(sh|ch)[ae]n\b",
                      lambda m: (m.group(1) + " " if m.group(1) else "") + "Kan-chan", text, flags=re.I)
        text = re.sub(r"\[[^\]]*\]|\([^)]*\)|（[^）]*）", " ", text)   # [BLANK_AUDIO], (music), ...
        return re.sub(r"\s+", " ", text).strip()


def has_japanese(text):
    return bool(re.search(r"[぀-ヿ一-鿿]", text))


