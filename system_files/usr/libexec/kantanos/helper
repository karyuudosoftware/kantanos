                box.setIcon(QMessageBox.Question)
                box.setText(f"Send what you say to {host} for this conversation?")
                box.setInformativeText("Your words and the PC's report go to the online AI you chose in AI "
                                       "settings, with personal details removed. Only the text is sent; the "
                                       "recording stays on this PC. You'll be asked again next time you open "
                                       "the Helper.")
                box.setDetailedText(redact(self.report))
                box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
                box.button(QMessageBox.Yes).setText("Send")
                box.button(QMessageBox.No).setText("Don't send")
                if box.exec() != QMessageBox.Yes:
                    return self.reply_without_ai(text, "Nothing was sent.")
                self.chat_online_ok = True
            history = [{"role": m["role"], "content": redact(m["content"])} for m in self.chat]
            report = redact(self.report)
        else:
            model = self.cfg.get("local_model") or local_model()[0]
            if not ollama_up() or not local_ready(model):
                return self.reply_without_ai(text, "The AI on this PC isn't set up yet (AI settings → Set up), "
                                                   "so I can only suggest repairs by keyword.")
            history, report = list(self.chat), self.report
        person = self.me.get("name", "") if provider != "online" else ""   # never sent online
        self.status.setText(f"{self.char_name} is thinking…")
        self.talk_btn.setEnabled(False)
        self.in_thread("chat", chat_ai, self.cfg, self.char_name, history, report.strip(), person)

    def reply_without_ai(self, text, why):
        picked = []
        for pattern, ids in KEYWORDS:
            if re.search(pattern, text.lower()):
                picked += [i for i in ids if i not in picked]
        reply = (f"{why} These might help." if picked else
                 f"{why} Try “Look for problems”, or set up the AI in AI settings so we can talk properly.")
        self.answer({"reply": reply, "fixes": picked[:2]}, keep=False)

    def answer(self, ans, keep=True):
        self.talk_btn.setEnabled(True)
        self.status.setText("")
        reply = ans.get("reply") or "Hmm, I'm not sure. Could you say that another way?"
        self.bubble(reply, False)
        if keep:
            self.chat.append({"role": "assistant", "content": reply})
        for fid in ans.get("fixes", []):
            self.fix_card(fid)
        self.scroll_down()
        self.mood("worried" if ans.get("fixes") else "happy")
        self.say(reply, force=True)

    # -- your name --
    def show_name(self):
        name = self.me.get("name")
        self.name_btn.setText(f"{self.char_name} calls you {name} (change)" if name else
                              f"Tell {self.char_name} your name")

    def ask_name(self):
        self.cfg["name_asked"] = True
        save(self.cfg)
        d = self.name_dialog = NameDialog(self, self.me)
        ok = d.exec() == QDialog.Accepted
        self.name_dialog = None
        if not ok:
            return
        self.me = d.result_me()
        save_me(self.me)
        self.show_name()
        if self.me.get("name"):
            self.mood("happy")
            self.say(f"Nice to meet you, {self.me['name']}!")

    # -- Kan-chan --
    def mood(self, name):
        if self.avatar:
            self.avatar.set_mood(name)

    def talk_toggled(self, on):
        self.cfg["talk"] = on
        save(self.cfg)
        if not on:
            self.voice.stop()
            return
        if self.voice.ready():
            self.say(self.greeting)
            return
        ok = QMessageBox.question(self, TITLE, f"{self.char_name}'s voice runs on this PC and needs a one-time "
                                  f"download of {self.voice.download_note}. Download it now?",
                                  QMessageBox.Yes | QMessageBox.No)
        if ok != QMessageBox.Yes:
            self.talk.setChecked(False)
            return
        self.status.setText(f"Downloading {self.char_name}'s voice…")
        self.in_thread("voice-dl", self.voice.download)

    def say(self, text, force=False):
        """Reads text aloud when "Talk to me" is on (force: also when it's off, in a conversation)."""
        text = spoken(speakable(text or ""), self.me)
        if not text or not (self.talk.isChecked() or force) or not self.voice.ready():
            return
        if has_japanese(text) and not self.voice.japanese:
            return                          # her English voice can't read Japanese; the text is shown
        self.in_thread("voice-synth", self.voice.synthesize, text[:900])

    def mouth_step(self):
        if not self.avatar:
            return
        if self.level_i >= len(self.levels) or (self.voice.player and self.voice.player.poll() is not None):
            self.speech.stop()
            self.avatar.mouth = None
            return
        level = self.levels[self.level_i]
        self.level_i += 1
        self.avatar.mouth = "talk2" if level > 0.45 else "talk1" if level > 0.12 else None

    # -- helpers --
    def show_ai(self):
        if self.cfg.get("provider") == "online" and self.cfg.get("online_url"):
            host = urllib.parse.urlparse(self.cfg["online_url"]).hostname or "online"
            self.ai_label.setText(f"AI: online ({host})")
        else:
            self.ai_label.setText("AI: on this PC")

    def clear_results(self):
        while self.results_lay.count():
            w = self.results_lay.takeAt(0).widget()
            if w:
                w.deleteLater()

    def card(self, title, text, button=None, action=None):
        box = QFrame()
        box.setFrameShape(QFrame.StyledPanel)
        v = QVBoxLayout(box)
        t = QLabel(f"<b>{title}</b>")
        t.setWordWrap(True)
        v.addWidget(t)
        if text:
            b = QLabel(text)
            b.setWordWrap(True)
            b.setTextInteractionFlags(Qt.TextSelectableByMouse)
            v.addWidget(b)
        if button:
            h = QHBoxLayout()
            h.addStretch()
            p = QPushButton(button)
            p.clicked.connect(action)
            h.addWidget(p)
            v.addLayout(h)
        self.results_lay.addWidget(box)

    def in_thread(self, name, fn, *args):
        def work():
            try:
                self.bridge.done.emit(name, ("ok", fn(*args)))
            except Exception as e:  # noqa: BLE001 - shown to the user in plain words
                self.bridge.done.emit(name, ("error", str(e)))
        threading.Thread(target=work, daemon=True).start()

    # -- check-up --
    def start_check(self):
        self.look.setEnabled(False)
        self.clear_results()
        self.search_btn.setEnabled(False)
        self.mood("think")
        self.status.setText("Looking at what has happened on this PC recently…")
        self.in_thread("gather", gather)

    def on_done(self, name, result):
        kind, value = result
        if name == "gather":
            if kind == "error":
                return self.finish(f"Couldn't read the PC's reports ({value}).")
            self.findings, self.report = value
            self.claude_btn.setEnabled(True)
            self.ask(self.report)
        elif name == "ai":
            if kind == "error":
                self.show_without_ai(f"The AI didn't answer ({value}). Here is what I found:")
            else:
                self.show_answer(value)
        elif name == "fix":
            fid, ok, out = value if kind == "ok" else (None, False, value)
            title = FIXES[fid]["title"] if fid else "The repair"
            self.status.setText(f"✓ {title}: done." if ok else f"{title} didn't work: {out[-300:]}")
            self.mood("happy" if ok else "worried")
            self.say("Done! Is it working now?" if ok else "Hmm, that didn't work. Let's try something else.")
        elif name == "gather-bg":
            if kind == "ok":
                self.findings, self.report = value
                self.claude_btn.setEnabled(True)
        elif name == "stt-dl":
            self.talk_btn.setEnabled(True)
            if kind == "ok":
                self.status.setText(f"Ready! Hold “Hold to talk” and speak to {self.char_name}.")
                self.mood("happy")
            else:
                self.status.setText(f"The speech model didn't download ({value}). Check the internet and try again.")
        elif name == "stt":
            if kind == "ok":
                self.heard(value)
            else:
                self.talk_btn.setEnabled(True)
                self.mood("worried")
                self.status.setText(f"I couldn't understand the recording ({value}).")
        elif name == "name-heard":
            if self.name_dialog:
                self.name_dialog.heard(kind, value)
        elif name == "chat":
            if kind == "ok":
                self.answer(value)
            else:
                self.talk_btn.setEnabled(True)
                last = self.chat[-1]["content"] if self.chat else ""
                self.reply_without_ai(last, f"The AI didn't answer ({value[:80]}).")
        elif name == "voice-dl":
            self.status.setText("" if kind == "ok" else f"The voice didn't download ({value}).")
            if kind == "ok":
                self.say(self.greeting)
            else:
                self.talk.setChecked(False)
        elif name == "voice-synth":
            if kind == "ok":
                path, self.levels = value
                self.level_i = 0
                self.voice.play(path)
                self.speech.start()
        elif name == "setup":
            self.bar.hide()
            if kind == "ok" and value is True:
                self.status.setText("The AI on this PC is ready.")
            elif "newer version" in str(value).lower():
                # Ollama's library refuses an engine that is too old; never send people hunting
                # for downloads: KantanOS ships the engine and updates it
                self.status.setText("This PC's AI engine is too old for that model. KantanOS brings a newer "
                                    "one with its next update: restart the PC once it has updated (or run "
                                    "\"ujust kantan-update\" now), then press Set up again.")
            else:
                self.status.setText(f"Setting up the AI on this PC didn't finish: {value}")

    def ask(self, report):
        provider = self.cfg.get("provider", "local")
        if provider == "online":
            if not self.cfg.get("online_url"):
                return self.show_without_ai("Online AI is chosen but not set up (AI settings). Here is what I found:")
            text = redact(report)
            box = QMessageBox(self)
            box.setWindowTitle(TITLE)
            box.setIcon(QMessageBox.Question)
            host = urllib.parse.urlparse(self.cfg["online_url"]).hostname
            box.setText(f"Send this report to {host} for an explanation?")
            box.setInformativeText("Personal details (your name, network addresses, e-mail addresses) have been removed. "
                                   "Press “Show Details” to read exactly what is sent.")
            box.setDetailedText(text)
            box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
            box.button(QMessageBox.Yes).setText("Send")
            box.button(QMessageBox.No).setText("Don't send")
            if box.exec() != QMessageBox.Yes:
                return self.show_without_ai("Nothing was sent. Here is what I found:")
            report = text
        else:
            model = self.cfg.get("local_model") or local_model()[0]
            if not ollama_up() or not local_ready(model):
                return self.show_without_ai("The AI on this PC isn't set up yet (AI settings → Set up). "
                                            "Here is what I found:")
        self.status.setText("Working out what this means…")
        self.in_thread("ai", ask_ai, self.cfg, self.problem.toPlainText().strip(), report)

    def show_answer(self, answer):
        self.finish("")
        explanation = answer.get("explanation") or "I couldn't work it out from the reports."
        self.card("What I think", explanation)
        self.mood("worried" if answer["fixes"] else "happy")
        self.say(explanation)
        for fid in answer["fixes"]:
            self.fix_card(fid)
        self.search = answer.get("search", "")
        self.search_btn.setEnabled(bool(self.search) or bool(self.findings))
        if not answer["fixes"]:
            self.card("No repair from my list fits", "Try “Search online for a solution”, or ask in KantanOS's community.")

    def show_without_ai(self, intro):
        self.finish(intro)
        if self.findings:
            self.card("What I found", "\n".join("• " + f for f in self.findings))
            self.mood("worried")
            self.say("I found a few things. Have a look at what I found below.")
        else:
            self.card("Nothing looks wrong", "No crashes, failed services or recent errors.")
            self.mood("happy")
            self.say("Good news: nothing looks wrong on this PC.")
        text = self.problem.toPlainText().lower()
        picked = []
        for pattern, ids in KEYWORDS:
            if re.search(pattern, text):
                picked += [i for i in ids if i not in picked]
        for fid in picked[:3]:
            self.fix_card(fid)
        self.search = self.problem.toPlainText().strip()[:100]
        self.search_btn.setEnabled(bool(self.search))

    def fix_card(self, fid):
        fix = FIXES[fid]
        self.card(fix["title"], fix["why"], "Do this…", lambda _=False, f=fid: self.do_fix(f))

    def finish(self, text):
        self.look.setEnabled(True)
        self.status.setText(text)

    # -- actions (always confirmed) --
    def do_fix(self, fid):
        fix = FIXES[fid]
        ok = QMessageBox.question(self, TITLE, f"{fix['title']}?\n\n{fix['why']}\n\n{fix['undo']}",
                                  QMessageBox.Yes | QMessageBox.No)
        if ok != QMessageBox.Yes:
            return
        if fix.get("background"):
            subprocess.Popen(fix["cmd"], start_new_session=True)
            return
        self.status.setText(f"{fix['title']}…")

        def work():
            r = subprocess.run(fix["cmd"], capture_output=True, text=True)
            return fid, r.returncode == 0, (r.stderr or r.stdout).strip()
        self.in_thread("fix", work)

    def search_online(self):
        query = self.search or self.problem.toPlainText().strip()[:100]
        query = redact(query)
        ok = QMessageBox.question(self, TITLE, f"Search the web for:\n\n“{query} KantanOS Fedora KDE”\n\n"
                                  "This opens your web browser (DuckDuckGo).", QMessageBox.Yes | QMessageBox.No)
        if ok == QMessageBox.Yes:
            q = urllib.parse.quote_plus(query + " Fedora KDE")
            subprocess.Popen(["xdg-open", "https://duckduckgo.com/?q=" + q], start_new_session=True)

    def ask_claude(self):
        path = os.path.join(HOME, ".cache", "kantanos", "helper-report.txt")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write("Problem: " + (self.problem.toPlainText().strip() or "(check-up)") + "\n\n" + redact(self.report))
        ok = QMessageBox.question(self, TITLE, "Open Claude Code with this report?\n\nClaude Code works online with "
                                  "your Claude account, and asks before it changes anything.",
                                  QMessageBox.Yes | QMessageBox.No)
        if ok == QMessageBox.Yes:
            prompt = (f"Help me fix a problem on my KantanOS PC (Fedora/Bazzite atomic, KDE Plasma). "
                      f"The KantanOS Helper's report is in {path}. Explain simply and ask before changing anything.")
            subprocess.Popen(["konsole", "-e", "claude", prompt], start_new_session=True)

    # -- settings --
    def open_settings(self):
        d = Settings(self, self.cfg)
        if d.exec() == QDialog.Accepted:
            self.cfg = d.result_cfg()
            save(self.cfg)
            self.show_ai()
            if d.wants_setup:
                self.setup_local()

    def setup_local(self):
        model, size = local_model()
        self.cfg["local_model"] = model
        save(self.cfg)
        self.bar.show()
        self.bar.setRange(0, 0)
        self.status.setText(f"Setting up the AI on this PC: downloading {model} ({size}). This happens once.")

        def work():
            subprocess.run(["systemctl", "--user", "start", OLLAMA_UNIT])
            for _ in range(30):
                if ollama_up():
                    break
                threading.Event().wait(1)
            else:
                return "the AI service didn't start"
            req = urllib.request.Request(OLLAMA + "/api/pull", data=json.dumps({"model": model}).encode(),
                                         headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=3600) as r:
                for line in r:
                    msg = json.loads(line)
                    if msg.get("error"):
                        return msg["error"]
                    if msg.get("total"):
                        self.bridge.progress.emit(int(msg.get("completed", 0) * 100 // msg["total"]), msg.get("status", ""))
            return True
        self.in_thread("setup", work)

    def on_progress(self, pct, text):
        self.bar.setRange(0, 100)
        self.bar.setValue(pct)


class NameDialog(QDialog):
    """What should I call you? The name as it's written, and how it sounds (for her voice).
    Kept in ~/.config/kantanos/me.json for this account only; never sent online."""

    def __init__(self, helper, me):
        super().__init__(helper)
        self.h = helper
        self.setWindowTitle(f"{helper.char_name}: what should I call you?")
        self.setMinimumWidth(480)
        lay = QVBoxLayout(self)
        intro = QLabel(f"What should I call you? Everyone says their name a little differently, so tell me "
                       f"how it sounds too. You can type it the way it sounds, or say it to me.")
        intro.setWordWrap(True)
        lay.addWidget(intro)
        form = QFormLayout()
        self.name = QLineEdit(me.get("name", ""))
        self.name.setPlaceholderText("Your name, the way it's written")
        self.sound = QLineEdit(me.get("say", ""))
        self.sound.setPlaceholderText("The way it sounds, e.g. “Shiv-awn” for Siobhan")
        form.addRow("Your name", self.name)
        form.addRow("Sounds like", self.sound)
        lay.addLayout(form)
        row = QHBoxLayout()
        hear = QPushButton(QIcon.fromTheme("media-playback-start"), "Hear it")
        hear.setToolTip(f"{helper.char_name} says your name, so you can check it")
        hear.clicked.connect(self.hear)
        row.addWidget(hear)
        self.rec = QPushButton(QIcon.fromTheme("audio-input-microphone"), "Say it to me")
        self.rec.setToolTip("Click, say your name, then click again. The recording isn't kept.")
        self.rec.clicked.connect(self.record)
        self.rec.setVisible(helper.ears.ready())
        row.addWidget(self.rec)
        row.addStretch()
        lay.addLayout(row)
        self.note = QLabel()
        self.note.setWordWrap(True)
        lay.addWidget(self.note)
        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.button(QDialogButtonBox.Ok).setText("Save")
        buttons.button(QDialogButtonBox.Cancel).setText("Not now")
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        lay.addWidget(buttons)

    def hear(self):
        text = self.sound.text().strip() or self.name.text().strip()
        if not text:
            return self.note.setText("Type your name first.")
        if not self.h.voice.ready():
            return self.note.setText("I don't have my voice yet: switch on “Talk to me” (or wait for it to "
                                     "finish downloading) and try again.")
        self.h.in_thread("voice-synth", self.h.voice.synthesize, f"Nice to meet you, {text}!")
        self.note.setText("If it doesn't sound right, change the spelling under “Sounds like” and try again. "
                          "Splitting it into parts often helps, e.g. “Mah-ree-ah”.")

    def record(self):
        ears = self.h.ears
        if ears.recording():
            path = ears.stop()
            self.rec.setText("Say it to me")
            if not path:
                return self.note.setText("I didn't hear anything. Is the microphone on?")
            self.rec.setEnabled(False)
            self.note.setText("Listening back…")
            self.h.in_thread("name-heard", ears.transcribe, path)   # no name hint: how it sounds
            return
        try:
            ears.start()
        except OSError as e:
            return self.note.setText(f"The microphone couldn't be opened ({e}).")
        self.rec.setText("Done")
        self.note.setText("Say just your name, then click “Done”.")

    def heard(self, kind, value):
        self.rec.setEnabled(True)
        text = re.sub(r"[.,!?。、！？]", "", value or "").strip() if kind == "ok" else ""
        if not text:
            return self.note.setText("Sorry, I didn't catch that. Try again, a little closer to the microphone.")
        self.sound.setText(text)
        if not self.name.text().strip():
            self.name.setText(text)
        self.note.setText(f"I heard “{text}”. Press “Hear it” to check, and change the spelling if it's not "
                          "quite right.")

    def done(self, r):
        if self.h.ears.recording():
            path = self.h.ears.stop()
            if path and path == self.h.ears.wav:
                try:
                    os.remove(path)                  # closed while recording: nothing is kept
                except OSError:
                    pass
        super().done(r)

    def result_me(self):
        name, say = self.name.text().strip()[:60], self.sound.text().strip()[:60]
        if not name:
            return {}
        return {"name": name, "say": say if say and say.lower() != name.lower() else ""}


class Settings(QDialog):
    def __init__(self, parent, cfg):
        super().__init__(parent)
        self.setWindowTitle("AI settings")
        self.cfg = dict(cfg)
        self.wants_setup = False
        lay = QVBoxLayout(self)
        model, size = local_model()
        self.local = QRadioButton(f"On this PC (private, works offline) — {model}")
        self.online = QRadioButton("Online service (for harder problems; asks before sending anything)")
        group = QButtonGroup(self)
        group.addButton(self.local)
        group.addButton(self.online)
        (self.online if cfg.get("provider") == "online" else self.local).setChecked(True)
        lay.addWidget(self.local)
        ready = ollama_up() and local_ready(cfg.get("local_model") or model)
        setup = QPushButton("Ready ✓" if ready else f"Set up (downloads {size} once)")
        setup.setEnabled(not ready)
        setup.clicked.connect(self.setup_clicked)
        h = QHBoxLayout(); h.addSpacing(24); h.addWidget(setup); h.addStretch()
        lay.addLayout(h)
        lay.addWidget(self.online)
        form = QFormLayout()
        self.url = QLineEdit(cfg.get("online_url", ""))
        self.url.setPlaceholderText("https://…/v1  (OpenAI-compatible, e.g. FreeLLMAPI or OpenRouter)")
        self.key = QLineEdit(cfg.get("online_key", ""))
        self.key.setEchoMode(QLineEdit.Password)
        self.model = QLineEdit(cfg.get("online_model", ""))
        self.model.setPlaceholderText("model name, as the service lists it")
        form.addRow("Address", self.url)
        form.addRow("Key", self.key)
        form.addRow("Model", self.model)
        lay.addLayout(form)
        note = QLabel("Whichever AI you use, it can only suggest repairs from KantanOS's fixed list, "
                      "and you approve each one.")
        note.setWordWrap(True)
        lay.addWidget(note)
        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        lay.addWidget(buttons)

    def setup_clicked(self):
        self.local.setChecked(True)
        self.wants_setup = True
        self.accept()

    def result_cfg(self):
        cfg = dict(self.cfg)
        cfg["provider"] = "online" if self.online.isChecked() else "local"
        cfg["online_url"] = self.url.text().strip()
        cfg["online_key"] = self.key.text().strip()
        cfg["online_model"] = self.model.text().strip()
        return cfg


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("kantanos-helper")
    app.setDesktopFileName("kantanos-helper")
    w = Helper()
    if len(sys.argv) > 1:                 # e.g. kantanos-helper "no sound from the TV"
        w.problem.setPlainText(" ".join(sys.argv[1:]))
        QTimer.singleShot(1500, w.start_check)    # opened about a problem: start looking at once
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
