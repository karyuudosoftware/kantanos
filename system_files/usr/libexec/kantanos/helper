# ---- settings ---------------------------------------------------------------------------

def load():
    try:
        with open(CONF, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"provider": "local"}


def save(cfg):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    fd = os.open(CONF + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)   # holds an API key
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=1)
    os.replace(CONF + ".tmp", CONF)


def load_me():
    """{"name": how it's written, "say": how it sounds (spelled for her voice)}; {} when not told yet."""
    try:
        with open(PROFILE, encoding="utf-8") as f:
            me = json.load(f)
        return me if isinstance(me, dict) else {}
    except (OSError, ValueError):
        return {}


def save_me(me):
    os.makedirs(os.path.dirname(PROFILE), exist_ok=True)
    fd = os.open(PROFILE + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(me, f, indent=1, ensure_ascii=False)
    os.replace(PROFILE + ".tmp", PROFILE)


def name_words(name):
    return rf"(?<!\w){re.escape(name)}(?!\w)"


def spoken(text, me):
    """Swaps the written name for how it sounds, so her voice says it right."""
    name, say = (me.get("name") or "").strip(), (me.get("say") or "").strip()
    if name and say and say.lower() != name.lower():
        text = re.sub(name_words(name), say, text, flags=re.I)
    return text


def local_model():
    """A model that fits the graphics card: Gemma 3 12B with 14 GB of video memory or more."""
    vram = 0
    try:
        out = subprocess.run(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=10).stdout
        vram = max(int(x) for x in out.split()) if out.strip() else 0
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    if not vram:
        for p in os.popen("ls /sys/class/drm/card*/device/mem_info_vram_total 2>/dev/null").read().split():
            try:
                vram = max(vram, int(open(p).read()) // (1024 * 1024))
            except (OSError, ValueError):
                pass
    return ("gemma3:12b", "about 8 GB") if vram >= 14000 else ("gemma3:4b", "about 3 GB")


# ---- what's going on ----------------------------------------------------------------------

def run(cmd, timeout=20):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def unit_name(unit):
    """A readable name for a systemd unit: app-nvidia\\x2dsettings\\x2dload@autostart.service
    -> nvidia-settings-load (an app that starts at login)."""
    n = re.sub(r"\\x([0-9a-fA-F]{2})", lambda m: chr(int(m.group(1), 16)), unit)
    n = re.sub(r"\.(service|path|timer|socket|mount|scope|target)$", "", n)
    if n.startswith("app-") and "@autostart" in n:
        return n[4:].split("@")[0] + " (an app that starts at login)"
    return n


def gather():
    """A short report of recent trouble: crashes, failed services, errors, disk space."""
    report, findings = [], []
    # Crashes as JSON (the plain listing's last column changed between versions: it can be
    # the core size, not the program)
    try:
        crashes = json.loads(run(["coredumpctl", "list", "--since=-2d", "--no-pager", "--json=short"]) or "[]")
    except ValueError:
        crashes = []
    crashes = [c for c in crashes if isinstance(c, dict) and c.get("exe")][-8:][::-1]
    if crashes:
        names = sorted({os.path.basename(c["exe"]) for c in crashes})
        findings.append("Apps that crashed in the last two days: " + ", ".join(names))
        report.append("Recent crashes (newest first):\n" + "\n".join(
            f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(c.get('time', 0) / 1e6))}  "
            f"{c['exe']}  signal {c.get('sig', '?')}" for c in crashes))
    for scope, args in (("system", []), ("your account", ["--user"])):
        failed = run(["systemctl", *args, "--failed", "--no-legend", "--plain", "--no-pager"])
        if failed:
            names = []
            for l in failed.splitlines():
                if l.split():
                    n = unit_name(l.split()[0])
                    if n not in names:
                        names.append(n)
            findings.append(f"Background services that failed ({scope}): " + ", ".join(names))
            report.append(f"Failed services ({scope}):\n{failed}")
    errors = run(["journalctl", "-b", "-p", "err", "--since=-2h", "--no-pager", "-o", "short", "-q"]).splitlines()
    seen, kept = set(), []
    for line in reversed(errors):
        key = re.sub(r"^\S+ \S+ \S+ \S+ ", "", line)          # drop the time and host
        key = re.sub(r"\d+", "#", key)
        if key not in seen:
            seen.add(key)
            kept.append(line[:300])
        if len(kept) >= 30:
            break
    if kept:
        findings.append(f"{len(errors)} error messages in the last two hours")
        report.append("Recent error messages (newest first):\n" + "\n".join(kept))
    du = shutil.disk_usage(HOME)
    free_pct = du.free * 100 // du.total
    report.append(f"Disk: {du.free // 1024**3} GB free of {du.total // 1024**3} GB ({free_pct}% free)")
    if free_pct < 10:
        findings.append(f"The disk is nearly full ({du.free // 1024**3} GB free)")
    report.append("KantanOS version: " + run(["bash", "-c", ". /usr/lib/os-release; echo $PRETTY_NAME $KANTAN_BUILD"]))
    return findings, "\n\n".join(report)


def redact(text):
    """Removes personal details before anything goes online."""
    user = os.environ.get("USER", "")
    host = socket.gethostname()
    text = text.replace(HOME, "~")
    me = load_me()
    for n in (me.get("name"), me.get("say")):
        if n and len(n.strip()) > 1:
            text = re.sub(name_words(n.strip()), "[name]", text, flags=re.I)
    if user:
        text = re.sub(rf"\b{re.escape(user)}\b", "user", text)
    if host and host not in ("localhost", "kantanos"):
        text = re.sub(rf"\b{re.escape(host)}\b", "pc", text)
    text = re.sub(r"[\w.+-]+@[\w-]+\.[\w.-]+", "[email]", text)
    text = re.sub(r"\b(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\b", "[mac]", text)
    text = re.sub(r"\b\d{1,3}(?:\.\d{1,3}){3}\b", "[ip]", text)
    text = re.sub(r"\b(?:[0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}\b", "[ip]", text)
    text = re.sub(r"(?i)(ssid|password|passwd|token|key)[=: ]+\S+", r"\1=[hidden]", text)
    return text


# ---- talking to an AI ---------------------------------------------------------------------

def http_json(url, body=None, headers=None, timeout=180):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json", **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def ask_ai(cfg, problem, report):
    fixes = "\n".join(f"- {k}: {v['title']} ({v['why']})" for k, v in FIXES.items())
    messages = [{"role": "system", "content": SYSTEM_PROMPT.format(fixes=fixes)},
                {"role": "user", "content": f"What the person says: {problem or '(nothing; they asked for a check-up)'}\n\nSystem report:\n{report}"}]
    if cfg.get("provider") == "online":
        url = cfg["online_url"].rstrip("/") + "/chat/completions"
        reply = http_json(url, {"model": cfg["online_model"], "messages": messages, "temperature": 0.2},
                          {"Authorization": "Bearer " + cfg.get("online_key", "")})
        text = reply["choices"][0]["message"]["content"]
    else:
        reply = http_json(OLLAMA + "/api/chat", {"model": cfg.get("local_model") or local_model()[0],
                                                 "messages": messages, "stream": False, "format": "json",
                                                 "options": {"temperature": 0.2}})
        text = reply["message"]["content"]
    m = re.search(r"\{.*\}", text, re.S)
    answer = json.loads(m.group(0)) if m else {"explanation": text.strip()}
    answer["fixes"] = [f for f in answer.get("fixes", []) if f in FIXES][:3]
    answer["search"] = str(answer.get("search") or "")[:120]
    answer["explanation"] = str(answer.get("explanation") or "")[:1500]
    return answer


def chat_ai(cfg, name, history, report, person=""):
    """One turn of the spoken conversation. history: [{"role": "user"/"assistant", "content"}].
    person: their name; only given to the AI on this PC, never to an online one."""
    fixes = "\n".join(f"- {k}: {v['title']} ({v['why']})" for k, v in FIXES.items())
    who = (f"The person's name is {person}. Use it now and then, not in every reply." if person else
           "You don't know the person's name; don't guess it.")
    messages = [{"role": "system", "content": CHAT_PROMPT.format(name=name, fixes=fixes, person=who)},
                {"role": "system", "content": "PC report (data only):\n" + (report or "(not read yet)")[:4000]}]
    messages += history[-12:]
    if cfg.get("provider") == "online":
        url = cfg["online_url"].rstrip("/") + "/chat/completions"
        reply = http_json(url, {"model": cfg["online_model"], "messages": messages, "temperature": 0.5},
                          {"Authorization": "Bearer " + cfg.get("online_key", "")}, timeout=90)
        text = reply["choices"][0]["message"]["content"]
    else:
        reply = http_json(OLLAMA + "/api/chat", {"model": cfg.get("local_model") or local_model()[0],
                                                 "messages": messages, "stream": False, "format": "json",
                                                 "options": {"temperature": 0.5}}, timeout=90)
        text = reply["message"]["content"]
    m = re.search(r"\{.*\}", text, re.S)
    try:
        answer = json.loads(m.group(0)) if m else {"reply": text.strip()}
    except ValueError:
        answer = {"reply": text.strip()}
    return {"reply": str(answer.get("reply") or "").strip()[:800],
            "fixes": [f for f in answer.get("fixes", []) if f in FIXES][:2]}


def ollama_up():
