#!/usr/bin/python3
"""KantanOS: runs one task (a ujust recipe or a KantanOS program) in a small window instead of a
terminal: "Working…" while it runs, then the result in plain words. The task's own messages are
shown only when they are the answer (--show-output) or when something went wrong.

  task-window --title T --doing "Turning HDR on" --done "HDR is on." [--failed TEXT]
              [--show-output] [--ask QUESTION] [--restart] -- command [args…]

--ask        asks first (Yes/No) and does nothing on No
--restart    on success, offers "Restart now"
--self-test  prints "ok"
"""
import os
import re
import subprocess
import sys

ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\a]*\a")


def parse(argv):
    opts = {"title": "KantanOS", "doing": "Working", "done": "Done.", "failed": "That didn't work.",
            "show-output": False, "ask": "", "restart": False}
    if "--" not in argv:
        raise SystemExit("task-window: the command goes after --")
    i = argv.index("--")
    head, cmd = argv[:i], argv[i + 1:]
    j = 0
    while j < len(head):
        key = head[j].lstrip("-")
        if key in ("show-output", "restart"):
            opts[key] = True
            j += 1
        elif key in opts:
            opts[key] = head[j + 1]
            j += 2
        else:
            raise SystemExit(f"task-window: unknown option {head[j]}")
    if not cmd:
        raise SystemExit("task-window: no command")
    return opts, cmd


def tidy(text):
    """The task's messages without colour codes, terminal prompts or blank runs."""
    lines = [ANSI.sub("", ln).rstrip() for ln in text.replace("\r", "\n").splitlines()]
    lines = [ln for ln in lines if not ln.startswith("Press Enter")]
    return re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()


def self_test():
    o, c = parse(["--title", "T", "--doing", "D", "--show-output", "--", "echo", "hi"])
    assert o["title"] == "T" and o["show-output"] and c == ["echo", "hi"], (o, c)
    assert tidy("\x1b[1mBold\x1b[0m\n\n\n\nx\r\nPress Enter to close") == "Bold\n\nx", repr(tidy("\x1b[1mBold\x1b[0m\n\n\n\nx"))
    print("ok")


def main():
    if "--self-test" in sys.argv:
        return self_test()
    opts, cmd = parse(sys.argv[1:])

    from PySide6.QtCore import QProcess, QTimer
    from PySide6.QtGui import QFont, QFontDatabase, QIcon
    from PySide6.QtWidgets import (QApplication, QHBoxLayout, QLabel, QMessageBox, QPlainTextEdit,
                                   QProgressBar, QPushButton, QVBoxLayout, QWidget)

    app = QApplication(sys.argv)
    app.setApplicationName(opts["title"])
    if opts["ask"] and QMessageBox.question(None, opts["title"], opts["ask"]) != QMessageBox.Yes:
        return
    win = QWidget()
    win.setWindowTitle(opts["title"])
    win.setWindowIcon(QIcon.fromTheme("preferences-system"))
    win.setMinimumWidth(480)
    lay = QVBoxLayout(win)
    lay.setContentsMargins(24, 20, 24, 20)
    lay.setSpacing(12)
    head = QLabel(opts["doing"].rstrip(".…") + "…")
    f = QFont()
    f.setPointSizeF(f.pointSizeF() * 1.3)
    f.setBold(True)
    head.setFont(f)
    head.setWordWrap(True)
    bar = QProgressBar()
    bar.setRange(0, 0)
    bar.setTextVisible(False)
    out = QPlainTextEdit()
    out.setReadOnly(True)
    out.setFont(QFontDatabase.systemFont(QFontDatabase.GeneralFont))
    out.setVisible(False)
    out.setMinimumHeight(140)
    row = QHBoxLayout()
    row.addStretch(1)
    restart = QPushButton(QIcon.fromTheme("system-reboot"), "Restart now")
    restart.setVisible(False)
    restart.clicked.connect(lambda: subprocess.Popen(["systemctl", "reboot"]))
    close = QPushButton("Close")
    close.setEnabled(False)
    close.clicked.connect(win.close)
    row.addWidget(restart)
    row.addWidget(close)
    for w in (head, bar, out):
        lay.addWidget(w)
    lay.addLayout(row)

    proc = QProcess(win)
    proc.setProcessChannelMode(QProcess.MergedChannels)
    buf = []

    def read():
        buf.append(bytes(proc.readAllStandardOutput()).decode("utf-8", "replace"))

    def finish(code):
        read()
        text = tidy("".join(buf))
        bar.setVisible(False)
        close.setEnabled(True)
        close.setDefault(True)
        ok = code == 0
        head.setText(opts["done"] if ok else opts["failed"])
        if text and (opts["show-output"] or not ok):
            out.setPlainText(text)
            out.setVisible(True)
        restart.setVisible(ok and opts["restart"])
        win.adjustSize()

    proc.readyReadStandardOutput.connect(read)
    proc.finished.connect(lambda code, _s: finish(code))
    proc.errorOccurred.connect(lambda e: finish(1) if e == QProcess.FailedToStart else None)
    proc.start(cmd[0], cmd[1:])
    win.show()
    shot = os.environ.get("KANTAN_WINDOW_SHOT", "")      # tests: "picture.png:seconds"
    if shot:
        path, _, secs = shot.rpartition(":")
        QTimer.singleShot(int(float(secs) * 1000), lambda: (win.grab().save(path), app.quit()))
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
