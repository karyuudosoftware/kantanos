#!/usr/bin/python3
"""KantanOS Vintage Computers: old home computers and PCs through existing emulators from Flathub.

Each computer gets a folder in ~/Vintage/<name> for its disks and the family's own system files.
KantanOS never downloads ROMs, system disks or games. Where a free replacement for the system
software exists the emulator brings it (AROS for the Amiga, EmuTOS for the Atari ST, C-BIOS for
the MSX), so those start without anything extra.

  vintage              the computer shelf
  vintage --start ID   start one computer straight away (dos, win9x, amiga, atarist, c64, mac,
                       msx, spectrum)
  vintage --self-test
"""
import glob
import os
import queue
import shutil
import subprocess
import sys
import tempfile
import threading

