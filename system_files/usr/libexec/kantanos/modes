#!/usr/bin/python3
"""KantanOS mode chooser: a full-screen "what would you like to do?" screen.

Tiles come from *.mode files (INI, section [Mode]):
  /usr/share/kantanos/modes/*.mode          shipped with KantanOS
  ~/.config/kantanos/modes/*.mode           the user's own shortcuts (same file name = override)

Keys: Name, Name[ja], Comment, Comment[ja], Icon (desktop, tv, game, retro, web; or a full
path), Exec (shell command; empty = just go to the desktop), Flatpak (app that is installed
on first use), Order (number), Hidden (true/false).

  modes            show the chooser
  modes --login    same, but stay quiet if the user turned "show at startup" off
"""
import configparser
import locale
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import Property, QObject, QProcess, QTimer, QUrl, Signal, Slot
from PySide6.QtGui import QGuiApplication
from PySide6.QtQml import QQmlApplicationEngine

SYS_DIR = Path(os.environ.get("KANTAN_MODES_DIR", "/usr/share/kantanos/modes"))
USER_BASE = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "kantanos"
USER_DIR = USER_BASE / "modes"
PREFS = USER_BASE / "modes.conf"
LOOKS_DIR = Path(os.environ.get("KANTAN_LOOKS_DIR", "/usr/share/kantanos/looks"))
LOOK_STATE = USER_BASE / "look"
ICON_NAMES = ("desktop", "tv", "game", "retro", "web", "add")


def file_url(path):
    return QUrl.fromLocalFile(str(path)).toString()


def read_look(look_id):
    """A look's settings (tools/looks.py writes them) plus the files that go with it."""
    values = {}
    try:
        for line in (LOOKS_DIR / look_id / "look.conf").read_text(encoding="utf-8").splitlines():
            key, sep, value = line.partition("=")
            if sep:
                values[key.strip()] = value.strip().strip('"')
    except OSError:
        return None
    values["wallpaper"] = file_url(LOOKS_DIR / look_id / "wallpaper.png")
    values["logo"] = file_url(LOOKS_DIR / look_id / "logo.png")
    values["icons"] = file_url(LOOKS_DIR / look_id / "icons")
    values["label"] = values.get("LABEL_JA" if LANG == "ja" else "LABEL", look_id)
    return values


def look_ids():
    try:
        return (LOOKS_DIR / "order").read_text(encoding="utf-8").split()
    except OSError:
        return []


def current_look_id():
    try:
        look_id = LOOK_STATE.read_text(encoding="utf-8").split()[0]
        if (LOOKS_DIR / look_id / "look.conf").exists():
            return look_id
    except (OSError, IndexError):
        pass
    try:
        return (LOOKS_DIR / "default").read_text(encoding="utf-8").split()[0]
    except (OSError, IndexError):
        return "light"

STRINGS = {
    "en": {
        "title": "What would you like to do?",
        "add": "Add shortcut",
        "addHint": "A website or live stream as its own tile",
        "addTitle": "New shortcut",
        "name": "Name",
        "address": "Web address",
        "save": "Add",
        "cancel": "Cancel",
        "remove": "Remove",
        "install": "Not installed yet. Select to install.",
        "installing": "Installing %1. This can take a few minutes.",
        "failed": "%1 could not be installed. Check the internet connection and try again.",
        "ok": "OK",
        "atStartup": "Show this screen at startup",
        "restart": "Restart",
        "shutdown": "Shut down",
        "hint": "Arrow keys or mouse to choose, Enter to open, Esc for the desktop",
        "look": "Look",
    },
    "ja": {
        "title": "何をしますか？",
        "add": "ショートカットを追加",
        "addHint": "ウェブサイトやライブ配信をタイルにします",
        "addTitle": "新しいショートカット",
