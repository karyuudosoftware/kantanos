SYS_DIR = Path(os.environ.get("KANTAN_MODES_DIR", "/usr/share/kantanos/modes"))
USER_BASE = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "kantanos"
USER_DIR = USER_BASE / "modes"
PREFS = USER_BASE / "modes.conf"
LOOKS_DIR = Path(os.environ.get("KANTAN_LOOKS_DIR", "/usr/share/kantanos/looks"))
LOOK_STATE = USER_BASE / "look"
ICON_NAMES = ("desktop", "tv", "game", "retro", "web", "add", "restart")
sys.path.insert(0, str(SYS_DIR))
sys.path.insert(0, "/usr/share/kantanos/kanchan")
HELPER = os.environ.get("KANTAN_HELPER_PATH", "/usr/libexec/kantanos/helper")


def shortcut_ai():
    """The shortcut maker and the AI it asks: (module, ask or None, note key, host).
    Loaded only when "Add shortcut" opens, so the screen itself starts quickly."""
    import importlib.machinery
    import importlib.util
    import shortcut_ai as sa
    try:
        import brain
        loader = importlib.machinery.SourceFileLoader("kantanos_helper", HELPER)
        helper = importlib.util.module_from_spec(importlib.util.spec_from_loader("kantanos_helper", loader))
        loader.exec_module(helper)
        ep = brain.endpoint(helper.load(), helper.local_model()[0])
        if ep["kind"] == "ollama" and not (helper.ollama_up() and helper.local_ready(ep["model"])):
            return sa, None, "aiNone", ""
    except Exception as e:  # noqa: BLE001 - no AI: words are matched instead
        print("shortcut AI:", e, file=sys.stderr)
        return sa, None, "aiNone", ""

    def ask(prompt):
        return brain.complete(ep, [{"role": "user", "content": prompt}], temperature=0.2, timeout=90)
    if ep["kind"] == "openai":
        return sa, ask, "aiOnline", urllib.parse.urlparse(ep["url"]).hostname or "online"
    return sa, ask, "aiLocal", ""


def file_url(path):
    return QUrl.fromLocalFile(str(path)).toString()


def read_look(look_id):
    """A look's settings (tools/looks.py writes them) plus the files that go with it."""
    values = {}
    try:
        for line in (LOOKS_DIR / look_id / "look.conf").read_text(encoding="utf-8").splitlines():
            key, sep, value = line.partition("=")
            if sep:
                values[key.strip()] = value.strip().strip('"')
    except OSError:
        return None
    values["wallpaper"] = file_url(LOOKS_DIR / look_id / "wallpaper.png")
    values["logo"] = file_url(LOOKS_DIR / look_id / "logo.png")
    values["icons"] = file_url(LOOKS_DIR / look_id / "icons")
    values["label"] = values.get("LABEL_JA" if LANG == "ja" else "LABEL", look_id)
    return values


def look_ids():
    try:
        return (LOOKS_DIR / "order").read_text(encoding="utf-8").split()
    except OSError:
        return []


def current_look_id():
    try:
        look_id = LOOK_STATE.read_text(encoding="utf-8").split()[0]
        if (LOOKS_DIR / look_id / "look.conf").exists():
            return look_id
    except (OSError, IndexError):
        pass
    try:
        return (LOOKS_DIR / "default").read_text(encoding="utf-8").split()[0]
    except (OSError, IndexError):
        return "light"

