        cfg_exists = os.path.exists(lineup.CONFIG)
        if not cfg_exists:
            self.first_run()
        elif not self.lu or time.time() - getattr(self.lu, "made", 0) > 24 * 3600:
            self.rebuild(quiet=bool(self.lu))
            if self.lu:
                self.start_watching()
        else:
            self.start_watching()
            self.refresh_guide()

    # layout ---------------------------------------------------------------------------------
    def resizeEvent(self, _e):
        r = self.rect()
        self.video.setGeometry(r)
        w = min(r.width() - 80, 1500)
        self.info.setGeometry((r.width() - w) // 2, r.height() - 300, w, 260)
        self.guide.setGeometry(r)
        for p in (self.recordings, self.settings, self.search):
            if p.isVisible():
                p.setGeometry(r)
        self.numbox.adjustSize()
        self.numbox.move(r.width() - self.numbox.width() - 60, 50)

    def say(self, text, ms=4000):
        self.msg.setText(text)
        self.msg.adjustSize()
        self.msg.move((self.width() - self.msg.width()) // 2, (self.height() - self.msg.height()) // 2)
        self.msg.show()
        self.msg.raise_()
        if ms:
            self.msg_timer.start(ms)
        else:
            self.msg_timer.stop()

    # channels -------------------------------------------------------------------------------
    def first_run(self):
        from PySide6.QtCore import QLocale
        cc = QLocale.system().name().split("_")[-1].upper()
        # A suggestion only: nothing is saved until they press Save.
        self.settings.open(first=True, suggest=cc if len(cc) == 2 and cc.isalpha() else "US")

    def rebuild(self, quiet=False):
        if not quiet:
            self.say("Getting the channels ready… (the first time takes a minute)", 0)

        def work():
            try:
                lu = lineup.Lineup(log=lambda *a: None).build()
                lineup.save_lineup(lu)
                lu.made = time.time()
                self.built.emit(lu, None)
            except Exception as e:                    # noqa: BLE001
                self.built.emit(None, str(e))
        threading.Thread(target=work, daemon=True).start()

    def on_built(self, lu, err):
        if lu is None:
            self.say(f"Couldn't get the channels: {err}. Is the internet connected?", 8000)
            return
        had = self.lu is not None and self.channel is not None
        self.lu = lu
        self.msg.hide()
        if lu.errors:
            self.say("Some channel lists couldn't be loaded:\n" + "\n".join(lu.errors[:4]), 6000)
        if not had:
            self.start_watching()
        self.refresh_guide(force=True)

    def refresh_guide(self, force=False):
        lu = self.lu

        def work():
            try:
                guide.refresh(lu, force=force, log=lambda *a: None)
            except Exception:                         # noqa: BLE001 - no guide is better than no TV
                pass
            self.guide_ready.emit()
        threading.Thread(target=work, daemon=True).start()

    def start_watching(self):
        if not self.lu or not self.lu.channels:
            self.say("No channels yet. Press M for settings.", 0)
            return
        c = self.lu.by_key.get(self.last_key) or self.lu.channels[0]
        self.zap_shelf = {"country": c["country"]}
        self.zap = self.lu.pick(c["country"])
        self.tune(c)

    def shelf_label(self):
        f = self.zap_shelf or {}
        if f.get("fav"):
            return "Favourites"
        if f.get("recent"):
            return "Recently watched"
        if f.get("found"):
            return f"Search: {f['found']}"
        if f.get("sub"):
            return f"{lineup.TOPIC_NAMES.get(f.get('topic'), '')} › {f['sub']}"
        if f.get("topic"):
            return lineup.TOPIC_NAMES.get(f["topic"], "")
        return "All channels"

    def tune(self, c, stream_i=0):
        self.file_mode = False
        if self.channel and self.channel["key"] != c["key"]:
            self.prev_key = self.channel["key"]
        self.channel = c
        self.stream_i = stream_i
        s = c["streams"][stream_i]
        self.video.play(s["url"], s.get("ua"), s.get("ref"))
        self.tune_timer.start()
        if stream_i == 0:
            self.say(f"{c['number']}  {c['name']}", 0)
            self.recent = [c["key"]] + [k for k in self.recent if k != c["key"]][:29]
            jsave(STATE, {"recent": self.recent, "last": c["key"], "prev": self.prev_key})
        self.refresh_info(show=True)

    def tuned(self):
        self.tune_timer.stop()
        if not self.file_mode and self.channel:
            self.broken.pop(self.channel["key"], None)
        self.msg.hide()

    def stream_ended(self, error):
        if self.file_mode:
            if not error:
                self.say("That's the end of the recording. Back to TV…", 2500)
                QTimer.singleShot(2500, self.back_to_live)
            return
        self.tune_failed()

    def tune_failed(self):
        self.tune_timer.stop()
        c = self.channel
        if not c or self.file_mode:
            return
        if self.stream_i + 1 < len(c["streams"]):
            self.tune(c, self.stream_i + 1)          # try the backup stream
            return
        self.broken[c["key"]] = time.time()
        jsave(BROKEN, self.broken)
        self.say(f"{c['number']}  {c['name']}\nThis channel isn't working right now. Try another one.", 6000)

    def is_broken(self, c):
        return c["key"] in self.broken

    def step(self, d):
        if not self.zap or not self.channel:
            return
        keys = [c["key"] for c in self.zap]
        i = keys.index(self.channel["key"]) if self.channel["key"] in keys else -1
        for _ in range(len(self.zap)):
            i = (i + d) % len(self.zap)
            if not self.is_broken(self.zap[i]):      # skip channels that just failed
                break
        self.tune(self.zap[i])

    def watch_from_guide(self, c, rows):
        f = self.guide.shelves[self.guide.shelf][1]
        self.zap_shelf = f
        self.zap = list(rows)
        self.guide.hide()
        self.setFocus()
        self.tune(c)

    def toggle_fav(self, c):
        if c["key"] in self.favs:
            self.favs.discard(c["key"])
            self.say(f"{c['name']} is no longer a favourite", 2000)
        else:
            self.favs.add(c["key"])
            self.say(f"★ {c['name']} added to Favourites", 2000)
        jsave(FAVS, sorted(self.favs))
        self.guide.update()
        self.refresh_info()

    # number keys ----------------------------------------------------------------------------
    def digit(self, d):
        self.typed = (self.typed + d)[-5:]
        self.numbox.setText(self.typed)
        self.numbox.adjustSize()
        self.numbox.move(self.width() - self.numbox.width() - 60, 50)
        self.numbox.show()
        self.numbox.raise_()
        self.num_timer.start()

    def commit_number(self):
        self.numbox.hide()
        n, self.typed = self.typed, ""
        if not n or not self.lu:
            return
        country = self.channel["country"] if self.channel else None
        if self.guide.isVisible():
            country = self.guide.country
        hit = next((c for c in self.lu.channels if c["country"] == country and str(c["number"]) == n), None)
        if not hit:
            self.say(f"There's no channel {n}", 2000)
            return
        if self.guide.isVisible():
            self.guide.hide()
        self.zap_shelf = {"country": hit["country"]}
        self.zap = self.lu.pick(hit["country"])
        self.tune(hit)

    # info and recording ---------------------------------------------------------------------
    def scheduled_keys(self):
        """{(channel key, programme start)} of everything that will be (or is being) recorded. A
        recording that starts late (recorded from the middle) still marks its programme."""
        out = set()
        for it in recorder.load_schedule()["items"]:
            if not it.get("cancelled"):
                for p in guide.window(self.db, [it["key"]], it["start"], it["start"] + 1)[it["key"]]:
                    out.add((it["key"], p["start"]))
                out.add((it["key"], it["start"]))
        return out

    def recording_now(self, c):
        st = recorder.load_status()
        return any(it["key"] == c["key"] and recorder.state_of(it, st) == "recording"
                   for it in recorder.load_schedule()["items"])

    def refresh_info(self, show=False):
        if not self.channel or self.file_mode:
            return
        progs = guide.now_next(self.db, self.channel["key"])
        self.info.show_for(self.channel, progs, self.shelf_label(), self.recording_now(self.channel),
                           self.channel["key"] in self.favs)
        if show:
            self.info.show()
            self.info.raise_()
            self.info_timer.start()

    def record_options(self, c, prog):
        m = tv_menu(self)
        now = time.time()
        if prog is None:
            m.addAction("Record this channel for an hour", lambda: self.record(c, None))
        else:
            title = prog["title"]
            started = prog["start"] <= now
            m.addAction(("Record the rest of " if started else "Record ") + f"“{title}”", lambda: self.record(c, prog))
            m.addAction(f"Record every episode of “{title}”", lambda: self.record(c, prog, every=True))
            if not started:
                m.addAction("Watch this channel now", lambda: self.watch_from_guide(c, self.guide.rows or [c]))
        sched = [it for it in recorder.load_schedule()["items"] if it["key"] == c["key"] and not it.get("cancelled")
                 and prog and abs(it["start"] - prog["start"]) < 120]
        for it in sched:
            m.addAction("Don't record it", lambda it=it: (recorder.cancel(it["id"]), self.say("Okay, it won't be recorded.", 2500),
                                                           self.guide.update()))
        m.adjustSize()
        show_menu(m, self.mapToGlobal(QPoint((self.width() - m.width()) // 2, (self.height() - m.height()) // 2)))

    def record(self, c, prog, every=False):
        now = time.time()
        if prog is None:
            recorder.add(c, c["name"], now, now + 3600)
            self.say(f"● Recording {c['name']} for an hour", 3000)
        else:
            recorder.add(c, prog["title"], max(now, prog["start"]), prog["stop"], prog.get("sub", ""))
            if every:
                recorder.add_rule(c, prog["title"])
                self.say(f"● Every episode of “{prog['title']}” on {c['name']} will be recorded", 3500)
            else:
                when = "now" if prog["start"] <= now else f"at {clock(prog['start'])}"
                self.say(f"● “{prog['title']}” will be recorded {when}", 3000)
        self.ensure_recorder()
        self.guide.update()
        QTimer.singleShot(8000, self.refresh_info)

    def ensure_recorder(self):
        import subprocess
        subprocess.Popen(["systemctl", "--user", "start", "kantanos-tv-recorder.service"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # recordings playback --------------------------------------------------------------------
    def play_file(self, files, it):
        self.file_mode = True
        self.tune_timer.stop()
        self.info.hide()
        self.video.command("loadfile", files[0], "replace")
        for f in files[1:]:
            self.video.command("loadfile", f, "append")
        self.say(f"{it['title']}\nSpace: pause · ← →: back / forward · Esc: back to TV", 4000)

    def back_to_live(self):
        self.file_mode = False
        if self.channel:
            self.tune(self.channel)

    # menus ----------------------------------------------------------------------------------
    def open_search(self):
        self.guide.hide()
        self.info.hide()
        self.search.open()

    def watch_search(self, c, rows):
        """Watch a channel found by searching; up/down then moves through what was found."""
        self.zap_shelf = {"found": self.search.box.text().strip()}
        self.zap = list(rows)
        self.setFocus()
        self.tune(c)

    def open_menu(self):
        self.guide.hide()
        self.recordings.open()

    def open_settings(self):
        self.settings.open()

    # keys -----------------------------------------------------------------------------------
    def keyPressEvent(self, e):
        k = e.key()
        if self.file_mode:
            if k == Qt.Key.Key_Space or k == Qt.Key.Key_MediaTogglePlayPause:
                self.video.command("cycle", "pause")
            elif k == Qt.Key.Key_Left:
                self.video.command("seek", "-10")
            elif k == Qt.Key.Key_Right:
                self.video.command("seek", "30")
            elif k in (Qt.Key.Key_Escape, Qt.Key.Key_Back, Qt.Key.Key_MediaStop):
                self.back_to_live()
            return
        if e.text().isdigit():
            self.digit(e.text())
        elif k in (Qt.Key.Key_Up, Qt.Key.Key_PageUp, Qt.Key.Key_ChannelUp, Qt.Key.Key_Plus):
            self.step(1)
        elif k in (Qt.Key.Key_Down, Qt.Key.Key_PageDown, Qt.Key.Key_ChannelDown, Qt.Key.Key_Minus):
            self.step(-1)
        elif k in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Select, Qt.Key.Key_I, Qt.Key.Key_Info):
            if self.typed:
                self.commit_number()
            elif self.info.isVisible():
                self.info.hide()
                self.open_guide()
            else:
                self.refresh_info(show=True)
        elif k in (Qt.Key.Key_Right, Qt.Key.Key_G, Qt.Key.Key_Guide):
            self.open_guide()
        elif k in (Qt.Key.Key_M, Qt.Key.Key_Menu):
            self.open_menu()
        elif k in (Qt.Key.Key_Slash, Qt.Key.Key_Search, Qt.Key.Key_S):
            self.open_search()
        elif k in (Qt.Key.Key_Left, Qt.Key.Key_L):
            prev = self.lu.by_key.get(self.prev_key) if self.lu and self.prev_key else None
            if prev:
                self.tune(prev)
        elif k in (Qt.Key.Key_R, Qt.Key.Key_MediaRecord) and self.channel:
            progs = guide.now_next(self.db, self.channel["key"])
            now = progs[0] if progs and progs[0]["start"] <= time.time() else None
            self.record_options(self.channel, now)
        elif k == Qt.Key.Key_F and self.channel:
            self.toggle_fav(self.channel)
        elif k in (Qt.Key.Key_Escape, Qt.Key.Key_Back, Qt.Key.Key_Backspace):
            if self.info.isVisible() or self.numbox.isVisible():
                self.info.hide()
                self.numbox.hide()
                self.typed = ""
            elif time.time() - self.back_armed < 3:
                self.close()
            else:
                self.back_armed = time.time()
                self.say("Press Back again to leave Watch TV", 3000)
        elif k == Qt.Key.Key_F11:
            self.showNormal() if self.isFullScreen() else self.showFullScreen()

    def open_guide(self):
        if not self.lu or not self.lu.channels:
            return
        country = self.channel["country"] if self.channel else self.lu.countries()[0]
        self.info.hide()
        self.guide.open(country, self.zap_shelf if self.zap_shelf and len(self.zap_shelf) > 1 else
                        {"country": country}, self.channel)

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.RightButton:
            self.open_guide()
        else:
            self.refresh_info(show=True)

    def mouseDoubleClickEvent(self, _e):
        self.showNormal() if self.isFullScreen() else self.showFullScreen()

    def wheelEvent(self, e):
        self.step(1 if e.angleDelta().y() > 0 else -1)

    def closeEvent(self, e):
        jsave(STATE, {"recent": self.recent, "last": self.channel["key"] if self.channel else self.last_key,
                      "prev": self.prev_key})
        self.video.close_player()
        super().closeEvent(e)


def self_test():
    """Draws the guide, recordings and settings with a tiny made-up lineup and guide (no network,
    no video), and drives the guide with the keys."""
    import sqlite3
    import tempfile
    tmp = tempfile.mkdtemp()
    lineup.DATA = tmp
    recorder.SCHEDULE, recorder.STATUS = os.path.join(tmp, "schedule.json"), os.path.join(tmp, "status.json")
    guide.DB = os.path.join(tmp, "guide.sqlite")
    lu = lineup.Lineup({"countries": [], "services": {}, "providers": []}, log=lambda *a: None)
    lu.add("US", "News One", "http://127.0.0.1:9/a.m3u8", service="Free TV", topic="news")
    lu.add("US", "Comedy Two", "http://127.0.0.1:9/b.m3u8", service="Pluto TV", topic="shows", sub="Comedy")
    lu.add("CA", "Local Three", "http://127.0.0.1:9/c.m3u8", service="Free TV", topic="local", sub="Ontario")
    lu.number()
    assert [c["number"] for c in lu.channels] == [2, 100, 400], [c["number"] for c in lu.channels]
    db = guide.connect()
    now = int(time.time())
    db.executemany("insert into prog values (?,?,?,?,?,?,?,?,?)",
                   [(lu.channels[1]["key"], now - 600, now + 1200, "Evening News", "", "Today's news.", "News", "", ""),
                    (lu.channels[1]["key"], now + 1200, now + 3000, "Weather Hour", "", "", "", "", "")])
    db.commit()
    assert [p["title"] for p in guide.now_next(db, lu.channels[1]["key"])] == ["Evening News", "Weather Hour"]
    app = QApplication.instance() or QApplication(sys.argv)
    host = QWidget()
    host.resize(1280, 720)
    host.lu, host.db, host.favs, host.recent = lu, db, set(), []
    host.scheduled_keys = lambda: set()
    host.is_broken = lambda c: False
    host.toggle_fav = lambda c: host.favs.add(c["key"])
    host.digit = host.open_menu = lambda *a: None
    g = Guide(host)
    g.resize(1280, 720)
    picked = []
    g.watch.connect(lambda c, rows: picked.append(c["name"]))
    g.options.connect(lambda c, p: picked.append(p and p["title"]))
    g.open("US", {"country": "US"}, lu.channels[1])
    assert g.rows[g.row]["name"] == "News One"
    g.grab()

    def key(k):
        g.keyPressEvent(__import__("PySide6.QtGui", fromlist=["QKeyEvent"]).QKeyEvent(QEvent.Type.KeyPress, k,
                                                                                     Qt.KeyboardModifier.NoModifier))
    key(Qt.Key.Key_Right)
    assert g.selected_prog()["title"] == "Weather Hour"
    key(Qt.Key.Key_Return)
    assert picked[-1] == "Weather Hour"            # a programme that hasn't started: record options
    key(Qt.Key.Key_Left)
    key(Qt.Key.Key_Return)
    assert picked[-1] == "News One"                # on now: watch it
    key(Qt.Key.Key_Left)
    assert g.focus_left
    for _ in range(4):
        key(Qt.Key.Key_Up)
    assert g.shelves[g.shelf][1] is None           # the country chooser
    key(Qt.Key.Key_Right)
    assert g.country == "CA" and g.rows and g.rows[0]["name"] == "Local Three"
    key(Qt.Key.Key_Right)
    assert g.country == "US" and g.shelves[g.shelf][1] is None   # Right again: the next country
    g.grab()
    # the mouse: a click on the country line (right half) moves on, from any selected line
    from PySide6.QtGui import QMouseEvent, QWheelEvent
    from PySide6.QtCore import QPointF
    g.shelf = 4
    g.update()
    fm, _rh, left, *_r = g.metrics()
    first, lh, _fit = g.shelf_view(fm)
    y = 20 + (0 - first) * lh + lh // 2
    g.mousePressEvent(QMouseEvent(QEvent.Type.MouseButtonPress, QPointF(left - 30, y), QPointF(left - 30, y),
                                  Qt.MouseButton.LeftButton, Qt.MouseButton.LeftButton, Qt.KeyboardModifier.NoModifier))
    assert g.country == "CA", g.country
    # the wheel over the left side scrolls the categories, not the channels
    g.resize(1280, 260)
    g.shelf, g.shelf_top = 0, 0
    g.wheelEvent(QWheelEvent(QPointF(40, 100), QPointF(40, 100), QPoint(0, -120), QPoint(0, -120),
                             Qt.MouseButton.NoButton, Qt.KeyboardModifier.NoModifier, Qt.ScrollPhase.NoScrollPhase, False))
    g.grab()
    assert g.shelf_top > 0, g.shelf_top
    g.resize(1280, 720)
    # Settings and Recordings are in the left pane
    labels = [s[0] for s in g.shelves]
    assert any("Settings" in t for t in labels) and any("Recordings" in t for t in labels), labels
    opened = []
    host.open_settings = lambda: opened.append("settings")
    g.shelf = next(i for i, s in enumerate(g.shelves) if (s[1] or {}).get("panel") == "settings")
    g.focus_left = True
    key(Qt.Key.Key_Return)
    assert opened == ["settings"], opened
    for cls in (Recordings, Settings):
        p = cls(host)
        p.resize(1280, 720)
        p.grab()
    recorder.add(lu.channels[1], "Weather Hour", now + 1200, now + 3000)
    r = Recordings(host)
    r.fill()
    assert r.list.count() == 1 and "Will record" in r.list.item(0).text()
    host.channel = lu.channels[1]
    s = Search(host)
    s.box.setText("*news*")
    s.run()
    texts = [s.list.item(i).text() for i in range(s.list.count())]
    assert texts[0] == "Channels (1)" and "News One" in texts[1] and texts[2].startswith("Shows in the guide (1)") \
        and "Evening News" in texts[3], texts
    s.box.setText("weather*")
    s.run()
    assert s.list.count() == 2 and "Weather Hour" in s.list.item(1).text()
    s.grab()
    db.close()
    sqlite3.connect(":memory:").close()
    print("tv self-test ok")


def main():
    if "--self-test" in sys.argv:
        self_test()
        return
    QApplication.setApplicationName("kantanos-tv")
    QApplication.setDesktopFileName("kantanos-tv")
    app = QApplication(sys.argv)
    tv = TV(windowed="--window" in sys.argv)
    tv.setFocus()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
