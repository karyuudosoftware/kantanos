    # countries: every country with free channels, found by typing --------------------------
    def load_countries(self):
        fallback = [{"code": cc, "name": n, "flag": "", "streams": 0, "guide": False} for cc, n in COUNTRY_NAMES.items()]
        self.fill_countries(sorted(fallback, key=lambda x: x["name"]))

        def work():
            try:
                self.countries_loaded.emit(lineup.country_list())
            except (OSError, ValueError):
                pass
        threading.Thread(target=work, daemon=True).start()

    def fill_countries(self, countries):
        COUNTRY_NAMES.update({c["code"]: c["name"] for c in countries})
        self.country_list.blockSignals(True)
        self.country_list.clear()
        for c in countries:
            extra = []
            if c["streams"]:
                extra.append(f"{c['streams']} free channel{'' if c['streams'] == 1 else 's'}")
            if c["guide"]:
                extra.append("Pluto TV / Plex with a full guide")
            li = QListWidgetItem(f"{c['flag']}  {c['name']}" + (f"   ·   {', '.join(extra)}" if extra else ""))
            li.setData(Qt.ItemDataRole.UserRole, c["code"])
            li.setFlags(li.flags() | Qt.ItemFlag.ItemIsUserCheckable)
            li.setCheckState(Qt.CheckState.Checked if c["code"] in self.chosen else Qt.CheckState.Unchecked)
            self.country_list.addItem(li)
        self.country_list.blockSignals(False)
        self.filter_countries(self.country_filter.text())
        self.show_chosen(read=False)

    def filter_countries(self, text):
        rx = lineup.wildcard(text) if text.strip() else None
        for i in range(self.country_list.count()):
            li = self.country_list.item(i)
            self.country_list.setRowHidden(i, bool(rx) and not rx.search(lineup.fold(li.text())))

    def show_chosen(self, read=True):
        if read:
            for i in range(self.country_list.count()):
                li = self.country_list.item(i)
                code = li.data(Qt.ItemDataRole.UserRole)
                if li.checkState() == Qt.CheckState.Checked:
                    self.chosen.add(code)
                else:
                    self.chosen.discard(code)
        names = ", ".join(sorted(country_name(c) for c in self.chosen)) or "none yet"
        self.chosen_label.setText(f"Chosen: {names}")

    def open(self, first=False, suggest=None):
        cfg = lineup.load_config()
        self.chosen = set(cfg.get("countries", [])) or ({suggest} if suggest else set())
        self.country_filter.clear()
        self.load_countries()
        for sid, b in self.svc.items():
            b.setChecked(cfg.get("services", {}).get(sid, True))
        p = (cfg.get("providers") or [{}])[0]
        self.p_name.setText(p.get("name", ""))
        self.p_m3u.setText(p.get("m3u", ""))
        self.p_xml.setText(p.get("xmltv", ""))
        self.folder.setText(cfg.get("record_dir") or lineup.DEFAULTS["record_dir"])
        self.head.setText("Welcome to Watch TV: which countries?" if first else "Watch TV settings")
        self.status.setText("Pick the countries whose channels you'd like, then press Save." if first else "")
        self.setGeometry(self.tv.rect())
        self.show()
        self.raise_()
        self.country_filter.setFocus()

    def pick_folder(self):
        d = QFileDialog.getExistingDirectory(self, "Where should recordings go?", self.folder.text())
        if d:
            self.folder.setText(d)

    def save(self):
        cfg = lineup.load_config()
        cfg["countries"] = sorted(self.chosen)
        if not cfg["countries"]:
            self.status.setText("Choose at least one country.")
            return
        cfg["services"] = {sid: b.isChecked() for sid, b in self.svc.items()}
        m3u = self.p_m3u.text().strip()
        if m3u and not m3u.startswith(("http://", "https://")):
            self.status.setText("The playlist link should start with http:// or https://.")
            return
        cfg["providers"] = [{"name": self.p_name.text().strip() or "My provider", "m3u": m3u,
                             "xmltv": self.p_xml.text().strip()}] if m3u else []
        cfg["record_dir"] = self.folder.text()
        lineup.save_config(cfg)
        self.close_panel()
        self.tv.rebuild()


