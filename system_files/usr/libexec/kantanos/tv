class InfoBar(QFrame):
    def __init__(self, parent):
        super().__init__(parent)
        self.setStyleSheet(f"InfoBar {{ background: {BG}; border-radius: 18px; }} QLabel {{ color: white; }}")
        g = QGridLayout(self)
        g.setContentsMargins(28, 18, 28, 18)
        self.num = big(QLabel(), 2.6, True)
        self.name = big(QLabel(), 1.7, True)
        self.where = big(QLabel(), 1.05)
        self.where.setStyleSheet("color: #aab8cc;")
        self.clock = big(QLabel(), 1.5)
        self.now = big(QLabel(), 1.35, True)
        self.now.setWordWrap(True)
        self.times = big(QLabel(), 1.05)
        self.times.setStyleSheet("color: #aab8cc;")
        self.bar = QFrame()
        self.bar.setFixedHeight(6)
        self.fill = QFrame(self.bar)
        self.fill.setStyleSheet("background: #50a0ff; border-radius: 3px;")
        self.bar.setStyleSheet("background: rgba(255,255,255,40); border-radius: 3px;")
        self.next = big(QLabel(), 1.1)
        self.next.setStyleSheet("color: #d0d8e4;")
        self.badges = big(QLabel(), 1.2, True)
        self.hint = QLabel("OK: guide · R: record · F: favourite")
        self.hint.setStyleSheet("color: #8090a8;")
        g.addWidget(self.num, 0, 0, 2, 1, Qt.AlignmentFlag.AlignTop)
        g.addWidget(self.name, 0, 1)
        g.addWidget(self.badges, 0, 2, Qt.AlignmentFlag.AlignRight)
        g.addWidget(self.clock, 0, 3, Qt.AlignmentFlag.AlignRight)
        g.addWidget(self.where, 1, 1, 1, 3)
        g.addWidget(self.now, 2, 1, 1, 3)
        g.addWidget(self.times, 3, 1, 1, 3)
        g.addWidget(self.bar, 4, 1, 1, 3)
        g.addWidget(self.next, 5, 1, 1, 2)
        g.addWidget(self.hint, 5, 3, Qt.AlignmentFlag.AlignRight)
        g.setColumnStretch(1, 1)
        g.setColumnMinimumWidth(0, 150)

    def show_for(self, ch, progs, shelf, recording, fav):
        self.num.setText(str(ch.get("number") or ""))
        self.name.setText(ch["name"])
        svc = ", ".join(dict.fromkeys(s["service"] for s in ch["streams"]))
        self.where.setText(f"{country_name(ch['country'])} · {shelf} · {svc}")
        self.clock.setText(clock(time.time()))
        b = []
        if recording:
            b.append("<span style='color:#ff5050'>● REC</span>")
        if fav:
            b.append("<span style='color:#ffd040'>★</span>")
        self.badges.setText("  ".join(b))
        now = progs[0] if progs and progs[0]["start"] <= time.time() else None
        nxt = progs[1] if now and len(progs) > 1 else (progs[0] if progs and not now else None)
        if now:
            ep = f"  ({now['ep']})" if now["ep"] else ""
            self.now.setText(now["title"] + (f": {now['sub']}" if now["sub"] and now["sub"] != now["title"] else "") + ep)
            self.times.setText(f"{clock(now['start'])} – {clock(now['stop'])}")
            frac = (time.time() - now["start"]) / max(1, now["stop"] - now["start"])
            self.bar.show()
            QTimer.singleShot(0, lambda: self.fill.setGeometry(0, 0, int(self.bar.width() * min(1, frac)), 6))
        else:
            self.now.setText("No guide for this channel" if not progs else "")
            self.times.setText("")
            self.bar.hide()
        self.next.setText(f"Next: {clock(nxt['start'])}  {nxt['title']}" if nxt else "")


# ---- the guide ------------------------------------------------------------------------------
class Guide(QWidget):
    """Left: country and shelves (Favourites, News, TV shows › Comedy, ...). Right: what's on
    when, drawn as a grid. Arrow keys move, OK watches or offers to record."""
    watch = Signal(dict, list)
    options = Signal(dict, object)

    SLOT = 1800

    def __init__(self, tv):
        super().__init__(tv)
        self.tv = tv
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        self.shelves = []           # [(label, filter, indent)]
        self.shelf = 0
        self.shelf_top = 0          # first line shown in the left pane (the wheel scrolls it)
        self.focus_left = False
        self.rows = []
        self.row = 0
        self.top = 0
        self.cursor = time.time()
        self.t0 = self.slot_floor(time.time())
        self.cache = {}
        f = self.font()
        f.setPointSizeF(f.pointSizeF() * 1.25)
        self.setFont(f)

    def shelf_view(self, fm, follow=True):
        """(first line shown, line height, lines that fit) for the left pane; with follow, the
        selected line is kept in view."""
        lh = int(fm.height() * 1.7)
        fit = max(1, (self.height() - 40) // lh)
        if follow:
            if self.shelf < self.shelf_top:
                self.shelf_top = self.shelf
            elif self.shelf >= self.shelf_top + fit:
                self.shelf_top = self.shelf - fit + 1
        self.shelf_top = min(max(0, self.shelf_top), max(0, len(self.shelves) - fit))
        return self.shelf_top, lh, fit

    def switch_country(self, step):
        cs = self.tv.lu.countries()
        if len(cs) > 1:
            i = (cs.index(self.country) + step) % len(cs) if self.country in cs else 0
            self.country = cs[i]
            self.build_shelves()
            self.shelf = 0                           # stay on the country line (Right again: next)
            self.shelf_top = 0
            self.rows = self.channels_for({"country": self.country})   # its channels alongside
            self.row = self.top = 0
            self.cache.clear()
            self.focus_left = True
            self.update()

    @staticmethod
    def slot_floor(t):
        return int(t // Guide.SLOT * Guide.SLOT)

    # data ---------------------------------------------------------------------------------
    def open(self, country, shelf_filter=None, channel=None):
        self.country = country
        self.build_shelves()
        if shelf_filter is not None:
            for i, (_l, f, _ind) in enumerate(self.shelves):
                if f == shelf_filter:
                    self.shelf = i
                    break
        self.load_rows(channel)
        self.t0 = self.slot_floor(time.time())
        self.cursor = time.time()
        self.focus_left = False
        self.cache.clear()
        self.show()
        self.raise_()
        self.setFocus()
        self.update()

    def build_shelves(self):
        lu = self.tv.lu
        sh = [("country", None, 0), ("🔍 Search…", {"search": True}, 0),
              ("★ Favourites", {"fav": True}, 0), ("Recently watched", {"recent": True}, 0),
              ("All channels", {"country": self.country}, 0)]
        tail = [("⏺ Recordings", {"panel": "recordings"}, 0), ("⚙ Settings (countries, folder)", {"panel": "settings"}, 0)]
        for t, label, subs, n in lu.shelves(self.country):
            sh.append((f"{label}  ({n})", {"country": self.country, "topic": t}, 0))
            if len(subs) > 1 or (subs and subs[0][1] < n):
                for s, k in subs:
                    sh.append((f"{s}  ({k})", {"country": self.country, "topic": t, "sub": s}, 1))
        self.shelves = sh + tail
        self.shelf = min(self.shelf, len(self.shelves) - 1) if self.shelf else 4

    def open_panel(self, f):
        """Recordings or Settings, from the guide's left pane."""
        self.hide()
        if f["panel"] == "settings":
            self.tv.open_settings()
        else:
            self.tv.open_menu()

    def channels_for(self, f):
        if f is None or f.get("search") or f.get("panel"):
            return []
        if f.get("fav"):
            return [c for c in self.tv.lu.channels if c["key"] in self.tv.favs]
        if f.get("recent"):
            return [self.tv.lu.by_key[k] for k in self.tv.recent if k in self.tv.lu.by_key]
        return self.tv.lu.pick(f.get("country"), f.get("topic"), f.get("sub"))

    def load_rows(self, channel=None):
        self.rows = self.channels_for(self.shelves[self.shelf][1])
        self.row = 0
        if channel:
            for i, c in enumerate(self.rows):
                if c["key"] == channel["key"]:
                    self.row = i
        self.top = max(0, self.row - 2)
        self.cache.clear()

    def progs(self, c):
        k = (c["key"], self.t0)
        if k not in self.cache:
            self.cache[k] = guide.window(self.tv.db, [c["key"]], self.t0 - 4 * 3600, self.t0 + 6 * 3600)[c["key"]]
        return self.cache[k]

    def selected_prog(self):
        if not self.rows:
            return None
        for p in self.progs(self.rows[self.row]):
            if p["start"] <= self.cursor < p["stop"]:
                return p
        return None

    # geometry -----------------------------------------------------------------------------
    def metrics(self):
        fm = QFontMetrics(self.font())
        rh = int(fm.height() * 2.6)
        left = int(self.width() * 0.22)
        name_w = int(self.width() * 0.17)
        head = int(fm.height() * 2.2)
        foot = int(fm.height() * 5.2)
        grid_x = left + name_w
        grid_w = self.width() - grid_x - 20
        span = 2.5 * 3600
        return fm, rh, left, name_w, head, foot, grid_x, grid_w, span

    def visible_rows(self):
        fm, rh, *_rest = self.metrics()
        head, foot = _rest[2], _rest[3]
        return max(1, (self.height() - head - foot - 20) // rh)

    # drawing ------------------------------------------------------------------------------
    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.fillRect(self.rect(), QColor(10, 14, 22, 235))
        fm, rh, left, name_w, head, foot, gx, gw, span = self.metrics()
        now = time.time()
        # shelves
        y = 20
        first, lh, _fit = self.shelf_view(fm, follow=not getattr(self, "wheeling", False))
        self.wheeling = False
        for i in range(first, len(self.shelves)):
            label, f, ind = self.shelves[i]
            if y > self.height() - lh:
                break
            r = QRect(16, y, left - 28, lh - 4)
            if i == self.shelf:
                p.setBrush(ACCENT if self.focus_left else QColor(60, 80, 110))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawRoundedRect(r, 10, 10)
            p.setPen(QColor("white") if i == self.shelf else QColor(200, 210, 225))
            if f is None:
                txt = f"◀  {country_name(self.country)}  ▶" if len(self.tv.lu.countries()) > 1 else country_name(self.country)
                font = QFont(self.font())
                font.setBold(True)
                p.setFont(font)
                p.drawText(r, Qt.AlignmentFlag.AlignCenter, txt)
                p.setFont(self.font())
            else:
                p.drawText(r.adjusted(14 + ind * 26, 0, -8, 0), Qt.AlignmentFlag.AlignVCenter, label)
            y += lh
        # time row
        p.setPen(QColor(170, 185, 205))
        for k in range(6):
            t = self.t0 + k * self.SLOT
            x = gx + int((t - self.t0) / span * gw)
            if x < gx + gw - 40:
                p.drawText(QRect(x + 6, 14, 200, head - 14), Qt.AlignmentFlag.AlignVCenter, clock(t))
        p.drawText(QRect(left, 14, name_w, head - 14), Qt.AlignmentFlag.AlignVCenter,
                   time.strftime("%A %-d %B", time.localtime(self.t0)))
        # rows
        vis = self.visible_rows()
        if self.row < self.top:
            self.top = self.row
        if self.row >= self.top + vis:
            self.top = self.row - vis + 1
        y = head + 10
        if not self.rows:
            p.setPen(QColor(200, 210, 225))
            f = self.shelves[self.shelf][1] or {}
            msg = "No favourites yet: press F on a channel to add it." if f.get("fav") else \
                "Press OK to search for a channel or show (* = anything)." if f.get("search") else "Nothing here yet."
            p.drawText(QRect(gx - name_w, y, gw + name_w, rh), Qt.AlignmentFlag.AlignCenter, msg)
        sched = self.tv.scheduled_keys()
        for i in range(self.top, min(len(self.rows), self.top + vis)):
            c = self.rows[i]
            sel_row = i == self.row
            broken = self.tv.is_broken(c)
            nr = QRect(left, y, name_w - 8, rh - 6)
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QColor(40, 55, 80) if sel_row else QColor(28, 34, 46))
            p.drawRoundedRect(nr, 8, 8)
            p.setPen(QColor(120, 130, 145) if broken else QColor("white"))
            p.drawText(nr.adjusted(12, 0, -6, 0), Qt.AlignmentFlag.AlignVCenter,
                       fm.elidedText(f"{c['number']}  {c['name']}", Qt.TextElideMode.ElideRight, name_w - 30))
            progs = self.progs(c)
            if not progs:
                r = QRect(gx, y, gw, rh - 6)
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(QColor(50, 70, 100) if sel_row and not self.focus_left else QColor(24, 30, 40))
                p.drawRoundedRect(r, 8, 8)
                p.setPen(QColor(150, 160, 175))
                p.drawText(r.adjusted(12, 0, -6, 0), Qt.AlignmentFlag.AlignVCenter,
                           "Not working right now" if broken else "No guide for this channel")
            for pr in progs:
                x1 = gx + int((pr["start"] - self.t0) / span * gw)
                x2 = gx + int((pr["stop"] - self.t0) / span * gw)
                x1, x2 = max(x1, gx), min(x2, gx + gw)
                if x2 - x1 < 4:
                    continue
                r = QRect(x1 + 2, y, x2 - x1 - 4, rh - 6)
                chosen = sel_row and not self.focus_left and pr["start"] <= self.cursor < pr["stop"]
                on_now = pr["start"] <= now < pr["stop"]
                p.setPen(Qt.PenStyle.NoPen)
                p.setBrush(ACCENT if chosen else (QColor(38, 50, 70) if on_now else QColor(28, 34, 46)))
                p.drawRoundedRect(r, 8, 8)
                p.setPen(QColor("white"))
                rec = (c["key"], pr["start"]) in sched
                txt = ("● " if rec else "") + pr["title"]
                p.drawText(r.adjusted(10, 0, -6, 0), Qt.AlignmentFlag.AlignVCenter,
                           fm.elidedText(txt, Qt.TextElideMode.ElideRight, max(0, r.width() - 16)))
            y += rh
        # now line
        xn = gx + int((now - self.t0) / span * gw)
        if gx <= xn <= gx + gw:
            p.setPen(QPen(QColor(255, 80, 80), 3))
            p.drawLine(xn, head, xn, y)
        # details of the chosen programme
        p.setPen(QColor("white"))
        dr = QRect(left, self.height() - foot, self.width() - left - 30, foot - 16)
        pr = None if self.focus_left else self.selected_prog()
        if pr:
            font = QFont(self.font())
            font.setBold(True)
            font.setPointSizeF(font.pointSizeF() * 1.15)
            p.setFont(font)
            head_txt = pr["title"] + (f": {pr['sub']}" if pr["sub"] and pr["sub"] != pr["title"] else "")
            p.drawText(dr.adjusted(0, 0, 0, -dr.height() + int(fm.height() * 1.6)), Qt.AlignmentFlag.AlignLeft, head_txt)
            p.setFont(self.font())
            p.setPen(QColor(170, 185, 205))
            meta = f"{clock(pr['start'])} – {clock(pr['stop'])}" + (f"   {pr['ep']}" if pr["ep"] else "") + \
                   (f"   {pr['cats']}" if pr["cats"] else "")
            p.drawText(dr.adjusted(0, int(fm.height() * 1.6), 0, 0), Qt.AlignmentFlag.AlignLeft, meta)
            p.setPen(QColor(215, 222, 232))
            p.drawText(dr.adjusted(0, int(fm.height() * 2.8), 0, 0), Qt.TextFlag.TextWordWrap, pr["descr"][:400])
        else:
            p.setPen(QColor(150, 165, 185))
            p.drawText(dr, Qt.AlignmentFlag.AlignLeft | Qt.TextFlag.TextWordWrap,
                       "Up and down to choose, OK to watch. Right goes into the guide; R records; F adds a "
                       "favourite; / searches; Esc closes. Recordings and settings: the Menu key or M.")

    # keys and mouse -----------------------------------------------------------------------
    def keyPressEvent(self, e):
        k = e.key()
        if k in (Qt.Key.Key_Escape, Qt.Key.Key_Back, Qt.Key.Key_Backspace):
            self.hide()
            self.tv.setFocus()
            return
        if k in (Qt.Key.Key_M, Qt.Key.Key_Menu):
            self.tv.open_menu()
            return
        if k in (Qt.Key.Key_Slash, Qt.Key.Key_Search, Qt.Key.Key_S) or \
                (self.focus_left and (self.shelves[self.shelf][1] or {}).get("search") and
                 k in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Select, Qt.Key.Key_Right)):
            self.tv.open_search()
            return
        if self.focus_left:
            self.keys_left(k)
        else:
            self.keys_grid(k, e.text())
        self.update()

    def keys_left(self, k):
        if k == Qt.Key.Key_Up:
            self.shelf = max(0, self.shelf - 1)
        elif k == Qt.Key.Key_Down:
            self.shelf = min(len(self.shelves) - 1, self.shelf + 1)
        elif self.shelves[self.shelf][1] is None and k in (Qt.Key.Key_Left, Qt.Key.Key_Right,
                                                            Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Select):
            self.switch_country(-1 if k == Qt.Key.Key_Left else 1)
            return
        elif (self.shelves[self.shelf][1] or {}).get("panel") and k in (
                Qt.Key.Key_Right, Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Select):
            self.open_panel(self.shelves[self.shelf][1])
            return
        elif k in (Qt.Key.Key_Right, Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Select):
            if self.rows:
                self.focus_left = False
            return
        if self.shelves[self.shelf][1] is not None:
            self.load_rows()

    def keys_grid(self, k, text):
        if not self.rows:
            if k == Qt.Key.Key_Left:
                self.focus_left = True
            return
        vis = self.visible_rows()
        c = self.rows[self.row]
        progs = self.progs(c)
        if k == Qt.Key.Key_Up:
            self.row = max(0, self.row - 1)
        elif k == Qt.Key.Key_Down:
            self.row = min(len(self.rows) - 1, self.row + 1)
        elif k in (Qt.Key.Key_PageUp, Qt.Key.Key_ChannelUp):
            self.row = max(0, self.row - vis)
        elif k in (Qt.Key.Key_PageDown, Qt.Key.Key_ChannelDown):
            self.row = min(len(self.rows) - 1, self.row + vis)
        elif k == Qt.Key.Key_Right:
            nxt = [p for p in progs if p["start"] > self.cursor]
            self.cursor = nxt[0]["start"] if nxt else self.cursor + self.SLOT
            while self.cursor > self.t0 + 2 * 3600:
                self.t0 += self.SLOT
        elif k == Qt.Key.Key_Left:
            cur = self.selected_prog()
            start = cur["start"] if cur else self.cursor - self.SLOT + 1
            if start <= time.time():                 # already on what's on now: over to the shelves
                self.focus_left = True
                self.cursor = time.time()
                self.t0 = self.slot_floor(time.time())
                return
            prev = [p for p in progs if p["stop"] <= start + 1]
            self.cursor = max(prev[-1]["start"] if prev else start - 1, time.time())
            while self.cursor < self.t0:
                self.t0 -= self.SLOT
        elif k in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Select):
            pr = self.selected_prog()
            if pr and pr["start"] > time.time() + 60:
                self.options.emit(c, pr)
            else:
                self.watch.emit(c, self.rows)
        elif k in (Qt.Key.Key_R, Qt.Key.Key_MediaRecord):
            self.options.emit(c, self.selected_prog())
        elif k == Qt.Key.Key_F:
            self.tv.toggle_fav(c)
        elif text.isdigit():
            self.tv.digit(text)
        self.cursor = max(self.cursor, time.time())   # the guide only looks forward

    def mousePressEvent(self, e):
        fm, rh, left, name_w, head, foot, gx, gw, span = self.metrics()
        pos = e.position().toPoint()
        if pos.x() < left:
            first, lh, _fit = self.shelf_view(fm, follow=False)
            i = first + (pos.y() - 20) // lh
            if 0 <= i < len(self.shelves):
                if self.shelves[i][1] is None:      # the country line: left half back, right half on
                    self.switch_country(-1 if pos.x() < left // 2 else 1)
                    return
                elif self.shelves[i][1].get("panel"):
                    self.open_panel(self.shelves[i][1])
                    return
                elif self.shelves[i][1].get("search"):
                    self.tv.open_search()
                    return
                else:
                    self.shelf = i
                    self.focus_left = True
                    self.load_rows()
        elif head + 10 <= pos.y() < self.height() - foot:
            i = self.top + (pos.y() - head - 10) // rh
            if 0 <= i < len(self.rows):
                self.row = i
                self.focus_left = False
                if pos.x() >= gx:
                    self.cursor = max(time.time(), self.t0 + (pos.x() - gx) / gw * span)
                if e.button() == Qt.MouseButton.RightButton:
                    self.options.emit(self.rows[i], self.selected_prog())
        self.update()

    def mouseDoubleClickEvent(self, e):
        if self.rows and not self.focus_left:
            pr = self.selected_prog()
            if pr and pr["start"] > time.time() + 60:
                self.options.emit(self.rows[self.row], pr)
            else:
                self.watch.emit(self.rows[self.row], self.rows)

    def wheelEvent(self, e):
        step = -1 if e.angleDelta().y() > 0 else 1
        fm, rh, left, *_rest = self.metrics()
        if e.position().x() < left:                  # over the categories: scroll them
            self.shelf_top += step * 2
            self.wheeling = True
        else:
            self.row = min(max(0, self.row + step * 3), max(0, len(self.rows) - 1))
        self.update()


