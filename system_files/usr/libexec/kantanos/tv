def jload(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def jsave(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(path + ".tmp", path)


def clock(t):
    return time.strftime("%-I:%M %p", time.localtime(t)).lower().replace(" ", "")


def country_name(cc):
    return COUNTRY_NAMES.get(cc, cc)


def big(widget, scale=1.4, bold=False):
    f = widget.font()
    f.setPointSizeF(f.pointSizeF() * scale)
    f.setBold(bold)
    widget.setFont(f)
    return widget


def tv_menu(parent):
    """A pop-up choice big enough to read from the sofa."""
    m = QMenu(parent)
    m.setStyleSheet(f"QMenu {{ background: {BG}; color: white; border: 1px solid #3a4a60; border-radius: 12px; "
                    "padding: 10px; } QMenu::item { padding: 16px 34px; border-radius: 8px; } "
                    "QMenu::item:selected { background: #3a78c8; }")
    big(m, 1.8)
    return m


def show_menu(m, pos):
    if m.actions():
        m.setActiveAction(m.actions()[0])           # the first choice is lit, so OK picks it
    m.exec(pos)


