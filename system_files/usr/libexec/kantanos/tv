        self.fill()
        self.setGeometry(self.tv.rect())
        self.show()
        self.raise_()
        self.list.setFocus()
        if self.list.count():
            self.list.setCurrentRow(0)

    def fill(self):
        self.list.clear()
        s = recorder.load_schedule()
        st = recorder.load_status()
        now = time.time()
        words = {"scheduled": "Will record", "recording": "● Recording now", "done": "Recorded",
                 "failed": "Didn't work", "missed": "Missed (the PC was off or asleep)", "cancelled": "Cancelled"}
        items = sorted(s["items"], key=lambda it: (recorder.state_of(it, st, now) not in ("recording",),
                                                  recorder.state_of(it, st, now) in ("done", "failed", "missed", "cancelled"),
                                                  -it["start"] if recorder.state_of(it, st, now) == "done" else it["start"]))
        for it in items:
            state = recorder.state_of(it, st, now)
            when = time.strftime("%a %-d %b, ", time.localtime(it["start"])) + clock(it["start"])
            text = f"{words[state]}:  {it['title']}" + (f": {it['sub']}" if it.get("sub") else "") + \
                   f"\n{when}  ·  {it['channel']}"
            if state == "failed" and st.get(it["id"], {}).get("why"):
                text += f"  ·  {st[it['id']]['why'][:80]}"
            li = QListWidgetItem(text)
            li.setData(Qt.ItemDataRole.UserRole, ("item", it, state))
            self.list.addItem(li)
        for r in s["rules"]:
            li = QListWidgetItem(f"Every episode:  {r['title']}\non {r['channel']}")
            li.setData(Qt.ItemDataRole.UserRole, ("rule", r, None))
            self.list.addItem(li)
        folder = lineup.load_config().get("record_dir")
        self.note.setText(f"Recordings are saved in {folder}. The PC stays awake while it records, but it can't "
                          "wake itself up: leave it on (the screen can be off) when something is due."
                          if self.list.count() else
                          "Nothing recorded yet. In the guide, choose a programme and press R (or OK on a "
                          "programme that hasn't started) to record it.")

    def chosen(self, li):
        kind, it, state = li.data(Qt.ItemDataRole.UserRole)
        m = tv_menu(self)
        if kind == "rule":
            m.addAction("Stop recording every episode", lambda: (recorder.remove_rule(it["title"], it.get("key")), self.fill()))
        elif state == "done":
            files = [f for f in recorder.load_status().get(it["id"], {}).get("files", []) if os.path.exists(f)]
            if files:
                m.addAction("Watch it", lambda: (self.hide(), self.tv.play_file(files, it)))
            m.addAction("Delete it", lambda: (recorder.forget(it["id"], delete_file=True), self.fill()))
            m.addAction("Remove from the list, keep the file", lambda: (recorder.forget(it["id"]), self.fill()))
        elif state in ("scheduled", "recording"):
            m.addAction("Stop recording" if state == "recording" else "Don't record it",
                        lambda: (recorder.cancel(it["id"]), QTimer.singleShot(1500, self.fill)))
        else:
            m.addAction("Remove from the list", lambda: (recorder.forget(it["id"], delete_file=True), self.fill()))
        rect = self.list.visualItemRect(li)
        show_menu(m, self.list.mapToGlobal(rect.center()))


class Search(Panel):
    """Find a channel or a show by typing. * means "anything", ? means "any one letter":
    "star trek*", "*news*", "jeopardy". Plain words match anywhere in the name."""

    def __init__(self, tv):
        super().__init__(tv, "Search")
        self.box = QLineEdit()
        big(self.box, 1.3)
        self.box.setPlaceholderText("A channel or show, e.g.  star trek*   or   *news*")
        self.box.setClearButtonEnabled(True)
        self.box.textChanged.connect(lambda _t: self.wait.start())
        self.box.returnPressed.connect(self.to_results)
        self.box.installEventFilter(self)
        hint = QLabel("* stands for anything and ? for any one letter. Plain words are found anywhere in the name. "
                      "Shows are found in the guide (now and the next three days).")
        hint.setWordWrap(True)
        hint.setStyleSheet("color: #aab8cc;")
        self.where = QCheckBox("Only this country")
        self.where.setStyleSheet("color: white;")
        self.where.toggled.connect(lambda _b: self.run())
        self.list = big(QListWidget(), 1.3)
        self.list.itemActivated.connect(self.chosen)
        self.count = QLabel()
        self.count.setStyleSheet("color: #aab8cc;")
        row = QHBoxLayout()
        row.addWidget(self.count, 1)
        row.addWidget(self.where)
        close = QPushButton(QIcon.fromTheme("window-close"), "Back to TV")
        close.clicked.connect(self.close_panel)
        row.addWidget(close)
        self.lay.addWidget(self.box)
        self.lay.addWidget(hint)
        self.lay.addWidget(self.list, 1)
        self.lay.addLayout(row)
        self.wait = QTimer(self, singleShot=True, interval=350, timeout=self.run)

    def open(self):
        self.setGeometry(self.tv.rect())
        self.show()
        self.raise_()
        self.box.setFocus()
        self.box.selectAll()
        self.run()

    def eventFilter(self, obj, e):
        if obj is self.box and e.type() == QEvent.Type.KeyPress and e.key() == Qt.Key.Key_Down:
            self.to_results()
            return True
        if obj is self.box and e.type() == QEvent.Type.KeyPress and e.key() in (Qt.Key.Key_Escape, Qt.Key.Key_Back):
            self.close_panel()
            return True
        return super().eventFilter(obj, e)

    def to_results(self):
        if self.list.count():
            self.list.setFocus()
            self.list.setCurrentRow(1 if self.list.item(0).flags() == Qt.ItemFlag.NoItemFlags else 0)

    def heading(self, text):
        li = QListWidgetItem(text)
        li.setFlags(Qt.ItemFlag.NoItemFlags)
        f = self.list.font()
        f.setBold(True)
        li.setFont(f)
        li.setForeground(QColor(170, 190, 220))
        self.list.addItem(li)

    def run(self):
        self.list.clear()
        text = self.box.text()
        tv = self.tv
        if not text.strip() or not tv.lu:
            self.count.setText("")
            return
        countries = {tv.channel["country"]} if self.where.isChecked() and tv.channel else None
        chans = lineup.search_channels(tv.lu, text, countries)
        many = len(tv.lu.countries()) > 1
        if chans:
            self.heading(f"Channels ({len(chans)})")
            for c in chans[:200]:
                where = f"   ·   {country_name(c['country'])}" if many else ""
                topic = lineup.TOPIC_NAMES.get(c["topic"], "") + (f" › {c['sub']}" if c["sub"] else "")
                li = QListWidgetItem(f"{c['number']}   {c['name']}\n{topic}{where}")
                li.setData(Qt.ItemDataRole.UserRole, ("channel", c, None))
                self.list.addItem(li)
        keys = {c["key"] for c in tv.lu.channels if not countries or c["country"] in countries}
        progs = [p for p in guide.search(tv.db, text, keys) if p["ch"] in tv.lu.by_key]
        if progs:
            self.heading(f"Shows in the guide ({len(progs)})")
            now = time.time()
            for p in progs:
                c = tv.lu.by_key[p["ch"]]
                when = "On now" if p["start"] <= now else \
                    (time.strftime("%a ", time.localtime(p["start"])) if p["start"] - now > 18 * 3600 else "") + \
                    clock(p["start"])
                title = p["title"] + (f": {p['sub']}" if p["sub"] and p["sub"] != p["title"] else "")
                li = QListWidgetItem(f"{when}   {title}\n{c['number']}  {c['name']}")
                li.setData(Qt.ItemDataRole.UserRole, ("prog", c, p))
                self.list.addItem(li)
        self.count.setText(f"{len(chans)} channels, {len(progs)} showings" if chans or progs else
                           "Nothing found. Try fewer letters, or * around a word: *word*")

    def chosen(self, li):
        data = li.data(Qt.ItemDataRole.UserRole)
        if not data:
            return
        kind, c, p = data
        if kind == "channel" or p["start"] <= time.time():
            rows = [d[1] for d in (self.list.item(i).data(Qt.ItemDataRole.UserRole) for i in range(self.list.count()))
                    if d and d[0] == "channel"] or [c]
            self.hide()
            self.tv.watch_search(c, rows)
        else:
            self.tv.record_options(c, p)


