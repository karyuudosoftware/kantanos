class Panel(QFrame):
    """A big, simple full-screen page over the TV picture."""

    def __init__(self, tv, title):
        super().__init__(tv)
        self.tv = tv
        self.setStyleSheet(f"Panel {{ background: rgba(10,14,22,252); }} QLabel {{ color: white; }} "
                           "QCheckBox { color: white; spacing: 12px; } QListWidget { background: rgba(255,255,255,12); "
                           "color: white; border: none; border-radius: 10px; } QListWidget::item { padding: 12px; } "
                           "QListWidget::item:selected { background: #3a78c8; border-radius: 8px; } "
                           "QPushButton { padding: 10px 22px; }")
        f = self.font()
        f.setPointSizeF(f.pointSizeF() * 1.25)
        self.setFont(f)
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(80, 50, 80, 40)
        self.lay.setSpacing(14)
        self.head = big(QLabel(title), 2.0, True)
        self.lay.addWidget(self.head)

    def keyPressEvent(self, e):
