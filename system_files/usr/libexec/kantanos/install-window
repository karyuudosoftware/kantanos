#!/usr/bin/python3
"""KantanOS: installs or removes an app (from Flathub) in a small window with a progress bar,
instead of Flatpak's text in a terminal. Used by KantanOS Welcome.

  install-window install <flatpak-id> [--name "Firefox"]
  install-window uninstall <flatpak-id> [--name "Firefox"]
  install-window --self-test

It uses Flatpak's own library (the same one the app store uses), so the bar shows real
progress: which part is downloading ("Firefox", "parts it needs: KDE Platform"), how much of
it has arrived, and the whole install's percentage. If another download is already running
(KantanOS fetches its starter apps after the first start), it says so and waits for it.
"""
import subprocess
import sys
import threading
import time

TITLE = "Apps"


def plain_part(ref, app_id, app_name):
    """What a Flatpak part is, in plain words."""
    kind, name = (ref.split("/") + ["", ""])[:2]
    if name == app_id:
        return app_name
    if name.endswith((".Locale", ".Debug")):
        return f"{app_name}: languages" if name.endswith(".Locale") else f"{app_name}: extras"
    nice = {"org.kde.Platform": "KDE Platform", "org.gnome.Platform": "GNOME Platform",
            "org.freedesktop.Platform": "Freedesktop Platform"}
    base = next((v for k, v in nice.items() if name.startswith(k)), name.rsplit(".", 1)[-1])
    return f"parts it needs: {base}" if kind == "runtime" else base


def size(n):
    return f"{n / 1e9:.1f} GB" if n >= 1e9 else f"{n / 1e6:.0f} MB"


def other_download(app_id):
    """Another Flatpak install/update/removal that's running now (it has to finish first)."""
    try:
        out = subprocess.run(["pgrep", "-af", r"(^|/)flatpak (install|update|uninstall)( |$)"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""
    for line in out.splitlines():
        if not line.rstrip().endswith(" " + app_id):
            return line.split()[-1]
    return ""


def self_test():
    assert plain_part("app/org.mozilla.firefox/x86_64/stable", "org.mozilla.firefox", "Firefox") == "Firefox"
    assert plain_part("runtime/org.kde.Platform/x86_64/6.9", "x", "X") == "parts it needs: KDE Platform"
    assert plain_part("runtime/org.mozilla.firefox.Locale/x86_64/stable", "org.mozilla.firefox", "Firefox") \
        == "Firefox: languages"
    assert size(1_500_000_000) == "1.5 GB" and size(42_000_000) == "42 MB"
    print("ok")


def main():
    args = sys.argv[1:]
    if args[:1] == ["--self-test"]:
        return self_test()
    if len(args) < 2 or args[0] not in ("install", "uninstall"):
        print(__doc__)
        return 2
    action, app_id = args[0], args[1]
    app_name = args[args.index("--name") + 1] if "--name" in args else app_id.rsplit(".", 1)[-1]

    import gi
    gi.require_version("Flatpak", "1.0")
    from gi.repository import Flatpak, GLib
    from PySide6.QtCore import QObject, QTimer, Signal
    from PySide6.QtGui import QFont, QFontDatabase, QGuiApplication, QIcon
    from PySide6.QtWidgets import (QApplication, QHBoxLayout, QLabel, QPlainTextEdit, QProgressBar,
                                   QPushButton, QVBoxLayout, QWidget)

    class Bridge(QObject):
        show = Signal(str, str, int)        # heading, detail, percent (-1: moving bar)
        done = Signal(bool, str)
        log = Signal(str)                   # a line for Details (the technical text)

    app = QApplication(sys.argv)
    app.setApplicationName(TITLE)
    app.setQuitOnLastWindowClosed(False)      # Hide: the install carries on, then this ends
    win = QWidget()
    win.setWindowTitle(f"{TITLE}: {app_name}")
    win.setWindowIcon(QIcon.fromTheme(app_id, QIcon.fromTheme("system-software-install")))
    win.setMinimumWidth(500)
    lay = QVBoxLayout(win)
    lay.setContentsMargins(24, 20, 24, 20)
    lay.setSpacing(12)
    head = QLabel(("Installing " if action == "install" else "Removing ") + app_name + "…")
    f = QFont()
    f.setPointSizeF(f.pointSizeF() * 1.3)
    f.setBold(True)
    head.setFont(f)
    head.setWordWrap(True)
    detail = QLabel("Getting ready…")
    detail.setWordWrap(True)
    bar = QProgressBar()
    bar.setRange(0, 0)
    # Details: the technical text, like a terminal, to read or copy (opens by itself on a problem)
    log = QPlainTextEdit()
    log.setReadOnly(True)
    log.setFont(QFontDatabase.systemFont(QFontDatabase.FixedFont))
    log.setMinimumHeight(170)
    log.setVisible(False)
    row = QHBoxLayout()
    more = QPushButton("Details ▾")
    more.setCheckable(True)
    copy = QPushButton(QIcon.fromTheme("edit-copy"), "Copy")
    copy.setToolTip("Copy the details, to paste into a message or a search")
    copy.setVisible(False)
    copy.clicked.connect(lambda: QGuiApplication.clipboard().setText(log.toPlainText()))

    def toggle(on):
        log.setVisible(on)
        copy.setVisible(on)
        more.setText("Details ▴" if on else "Details ▾")
        win.adjustSize()
    more.toggled.connect(toggle)
    row.addWidget(more)
    row.addWidget(copy)
    row.addStretch(1)
    close = QPushButton("Hide")
    close.setToolTip("It carries on in the background")
    close.clicked.connect(lambda: app.quit() if state.get("over") else win.hide())
    row.addWidget(close)
    for w in (head, detail, bar):
        lay.addWidget(w)
    lay.addLayout(row)
    lay.addWidget(log)
    bridge = Bridge()
    bridge.log.connect(lambda line: log.appendPlainText(time.strftime("%H:%M:%S  ") + line))

    def show(h, d, pct):
        if h:
            head.setText(h)
        detail.setText(d)
        if pct < 0:
            bar.setRange(0, 0)
        else:
            bar.setRange(0, 100)
            bar.setValue(pct)

    def done(ok, message):
        bar.setRange(0, 100)
        bar.setValue(100 if ok else bar.value())
        head.setText(message)
        detail.setText("" if ok else detail.text())
        close.setText("Close")
        close.setToolTip("")
        state["over"] = True
        if not ok:
            bar.hide()                         # the heading says it; the details say why
            detail.hide()
            more.setChecked(True)             # the error is there to read or copy
        if not win.isVisible():               # hidden while it ran: say how it went, then end
            subprocess.run(["notify-send", "-a", TITLE, "-i", app_id, message], timeout=10)
            app.quit()

    bridge.show.connect(show)
    bridge.done.connect(done)
    state = {"over": False, "code": 1}

    win.closeEvent = lambda e: (e.accept(), app.quit()) if state["over"] else (e.ignore(), win.hide())

    def work():
        started = time.time()
        while (other := other_download(app_id)):
            mins, secs = divmod(int(time.time() - started), 60)
            bridge.show.emit("", f"Another download is running first ({other}). This one starts as soon as "
                                 f"it finishes. Waiting {mins} min {secs:02d} s…", -1)
            time.sleep(3)
        try:
            inst = Flatpak.Installation.new_system(None)
            t = Flatpak.Transaction.new_for_installation(inst, None)
            t.set_no_interaction(True)
            bridge.log.emit(f"flatpak {action} --system flathub {app_id}")
            if action == "install":
                try:
                    inst.get_installed_ref(Flatpak.RefKind.APP, app_id, None, None, None)
                    t.add_update(f"app/{app_id}/{Flatpak.get_default_arch()}/stable", None, None)
                except GLib.Error:
                    t.add_install("flathub", f"app/{app_id}/{Flatpak.get_default_arch()}/stable", None)
            else:
                t.add_uninstall(f"app/{app_id}/{Flatpak.get_default_arch()}/stable")
            ops = {"total": 1, "index": 0}

            def ready(tr):
                ops["total"] = max(1, len(tr.get_operations()))
                return True

            def new_operation(_tr, op, progress):
                ops["index"] += 1
                part = plain_part(op.get_ref(), app_id, app_name)
                bridge.log.emit(f"{op.get_operation_type().value_nick} {op.get_ref()} "
                                f"(commit {(op.get_commit() or '')[:12]}, download {size(op.get_download_size() or 0)})")
                progress.set_update_frequency(300)

                def changed(p):
                    pct = p.get_progress()
                    overall = int(((ops["index"] - 1) + pct / 100) / ops["total"] * 100)
                    got, total = p.get_bytes_transferred(), op.get_download_size()
                    amount = f": {size(got)} of {size(total)}" if total and got and action == "install" else ""
                    step = f"Part {ops['index']} of {ops['total']}, " if ops["total"] > 1 else ""
                    bridge.show.emit("", f"{step}{part}{amount}", overall)
                progress.connect("changed", changed)
                changed(progress)

            def failed(_tr, op, error, _details):
                state["error"] = f"{plain_part(op.get_ref(), app_id, app_name)}: {error.message}"
                bridge.log.emit(f"ERROR in {op.get_ref()}: {error.domain} {error.code}: {error.message}")
                return False                    # stop: an install is all or nothing

            t.connect("ready", ready)
            t.connect("new-operation", new_operation)
            t.connect("operation-error", failed)
            t.run(None)
            state["code"] = 0
            bridge.log.emit("finished")
            bridge.done.emit(True, f"{app_name} is installed. It's in the app menu." if action == "install"
                             else f"{app_name} has been removed.")
        except GLib.Error as e:
            bridge.log.emit(f"ERROR: {e.domain} {e.code}: {e.message}")
            msg = state.get("error") or e.message
            if "already installed" in msg.lower():
                state["code"] = 0
                bridge.done.emit(True, f"{app_name} is already installed. It's in the app menu.")
                return
            if "no such ref" in msg.lower() or "nothing matches" in msg.lower():
                msg = "it wasn't found in the app library, Flathub"
            elif "not authorized" in msg.lower() or "dismissed" in msg.lower():
                msg = "the PC's password wasn't given"
            elif "resolve" in msg.lower() or "could not connect" in msg.lower() or "network" in msg.lower():
                msg = "is the internet connected?"
            bridge.show.emit("", msg, -1)
            bridge.done.emit(False, (f"{app_name} couldn't be installed" if action == "install"
                                     else f"{app_name} couldn't be removed") + f" ({msg}).")

    threading.Thread(target=work, daemon=True).start()
    win.show()
    app.exec()
    return state["code"]


if __name__ == "__main__":
    sys.exit(main() or 0)
