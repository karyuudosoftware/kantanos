<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KantanOS</vendor>
  <action id="org.kantanos.android-setup">
    <description>Set up Android apps</description>
    <message>Setting up Android apps needs permission to download Android and switch it on.</message>
    <!-- Only sets up Waydroid (Bazzite's own Android container) the way KantanOS needs it,
         like Bazzite's container start/stop actions: no password for the person at the PC. -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kantanos/android-setup</annotate>
  </action>
</policyconfig>
