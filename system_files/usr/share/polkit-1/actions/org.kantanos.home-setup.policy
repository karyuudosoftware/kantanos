<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>KantanOS</vendor>
  <action id="org.kantanos.home-setup">
    <description>Run Home Assistant on this PC</description>
    <message>Running Home Assistant on this PC needs permission to download and start it.</message>
    <!-- Only installs or removes KantanOS's own Home Assistant container: no password for
         the person at the PC, like the Android apps setup. -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kantanos/home-setup</annotate>
  </action>
</policyconfig>
