[Desktop Entry]
Type=Application
Name=Android apps
Name[ja]=Android アプリ
Comment=Run Android apps in their own windows; set up the first time
Exec=kantan-android
Icon=waydroid
Categories=Utility;
# Hidden (Nov 2026): most Play Store games refuse Waydroid, so it isn't offered; still works
